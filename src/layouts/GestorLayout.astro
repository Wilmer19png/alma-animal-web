---
// Molde de las páginas del gestor interno (/gestor). No aparece en Google ni carga lo del sitio público
// (pie de página, botón de WhatsApp). Cada página monta su pantalla de React con src/gestor/montar.ts.
import '../styles/global.css';
import '../gestor/gestor.css';

interface Props { title: string }
const { title } = Astro.props;
// íconos del gestor (deben ir en orden alfabético)
import { iconosUrl } from '../gestor/iconos';
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} · Gestor Alma Animal</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#2B1E48" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alan+Sans:wght@300..800&family=Gowun+Batang:wght@400;700&display=swap" />
  <link rel="stylesheet" href={iconosUrl()} />
</head>
<body class="gestor">
  <slot />
</body>
</html>
