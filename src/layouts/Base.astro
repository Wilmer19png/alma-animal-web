---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import WaIcon from '../components/WaIcon.astro';
import { whatsapp } from '../data/site';

interface Props { title: string; description: string; waMessage?: string; waArea?: 'vet' | 'shop'; image?: string; sinWa?: boolean }
const { title, description, waMessage, waArea = 'vet', image, sinWa = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const waHref = whatsapp[waArea](waMessage);
// subconjunto de íconos (deben ir en orden alfabético)
const ICONS = ['add', 'add_a_photo', 'add_shopping_cart', 'air', 'apartment', 'arrow_back', 'arrow_forward', 'auto_stories', 'bedtime', 'bolt', 'brush', 'calendar_month', 'call', 'chat', 'check', 'check_circle', 'chevron_right', 'clean_hands', 'cleaning_services', 'close', 'content_cut', 'cookie', 'cruelty_free', 'delete', 'dentistry', 'description', 'eco', 'expand_more', 'favorite', 'format_color_reset', 'grass', 'grid_on', 'hearing', 'home_health', 'inbox', 'info', 'link', 'local_fire_department', 'local_shipping', 'location_on', 'loyalty', 'mail', 'map', 'mark_email_read', 'medical_services', 'menu', 'movie', 'new_releases', 'pause', 'payments', 'person', 'pest_control', 'pets', 'photo_camera', 'photo_library', 'pill', 'play_arrow', 'play_circle', 'public', 'radiology', 'rainy', 'rate_review', 'recycling', 'redeem', 'remove', 'savings', 'school', 'search', 'sell', 'set_meal', 'shopping_bag', 'shower', 'smart_display', 'soap', 'sound_detection_dog_barking', 'spa', 'sports_baseball', 'star', 'stethoscope', 'storefront', 'straighten', 'timer', 'tune', 'two_wheeler', 'vaccines', 'verified', 'water_drop', 'waves', 'wifi_off'];
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <!-- enlaces de invitación o de contraseña nueva de Supabase: llegan al inicio y van a crear la contraseña -->
  <script is:inline>if (/[#&]type=(invite|recovery)/.test(location.hash)) location.replace('/gestor/clave' + location.hash);</script>
  <!-- Píxel de Meta (el PageView y los demás eventos salen de scripts/meta.ts, con su copia por la API de conversiones) -->
  <script is:inline>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','843169261930833');</script>
  <meta name="theme-color" content="#FEF7FE" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {image && <meta property="og:image" content={image} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alan+Sans:wght@300..800&family=Gowun+Batang:wght@400;700&display=swap" />
  <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0..1,0&icon_names=${ICONS.join(',')}&display=block`} />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <div class="anuncio" data-anuncio hidden><a></a></div>
  <slot name="top" />
  <main id="contenido">
    <slot />
  </main>
  <Footer />
  <CartDrawer />
  {!sinWa && <a class="fab-wa" href={waHref} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"><WaIcon size={30} class="" /></a>}

  <script>
    import '../scripts/contenido';
    import { track } from '../scripts/meta';
    track('PageView');
  </script>

  <style>
    .anuncio { padding: 9px 16px; background: var(--ink); color: #fff; text-align: center; font-size: 14.5px; font-weight: 500; line-height: 1.35; }
    .anuncio a { color: inherit; text-decoration: none; }
    .anuncio a[href] { text-decoration: underline; text-underline-offset: 3px; }
    .fab-wa { position: fixed; right: 16px; bottom: max(16px, env(safe-area-inset-bottom)); z-index: 40; width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--wa); color: #fff; box-shadow: 0 4px 8px 3px rgb(54 41 84 / .12), 0 1px 3px rgb(54 41 84 / .2); transition: transform .25s var(--ease-out); }
    .fab-wa:hover { color: #fff; transform: translateY(-2px) scale(1.04); }
    @media (min-width: 768px) { .fab-wa { right: 24px; bottom: 24px; width: 60px; height: 60px; } }
  </style>
</body>
</html>
