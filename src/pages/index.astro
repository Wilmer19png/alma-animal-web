---
import { TX, TT, CAMPOS } from '../data/contenido';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lockup from '../components/Lockup.astro';
import MobileMenu from '../components/MobileMenu.astro';
import CartLink from '../components/CartLink.astro';
import WaIcon from '../components/WaIcon.astro';
import WaStrip from '../components/WaStrip.astro';
import HomeVisit from '../components/HomeVisit.astro';
import { NAV, ADDRESS, PHONES, SOCIAL, DOCTOR, whatsapp } from '../data/site';
import { POSTS as BLOG_POSTS, BLOG_DEMO, postUrl } from '../data/blog';
import heartPaper from '../assets/papel-corazon-v2.png';
import tigerDog from '../assets/papel-tigre-perro-v3.png';
import paw from '../assets/pata-perro-h.png';
import claw from '../assets/garra-tigre.png';
import mariana from '../assets/mariana-gato.png';
import groomer from '../assets/peluquera.png';
import heart from '../assets/corazon.png';

// equipo del carrusel del héroe
const TEAM = [
  { img: mariana, alt: 'Dra. Mariana Hoyos Giraldo con un gato atigrado en brazos', who: 'Dra. Mariana Hoyos · MVZ', a: 'MVZ · TP 51206', b: 'Consulta a domicilio' },
  { img: groomer, alt: 'Peluquería canina de Alma Animal: schnauzer en brazos y herramientas de corte', who: 'Spa y peluquería', a: 'Spa con protocolo', b: 'Corte según la raza' }
];
const REASONS = [
  { n: '8', title: 'Cuidados en cada baño', text: 'Antipulgas, oídos, dientes, hidromasaje, aromaterapia, cepillado, deslanado y uñas.' },
  { n: '3', suffix: 'en 1', title: 'Consultorio, spa y petshop', text: 'Un solo lugar y una sola historia clínica para tu mascota.' },
  { n: '0', title: 'Parabenos en el shampoo', text: 'Hipoalergénico, y baño medicado para la piel sensible.' },
  { n: '1', title: 'Carnet digital por mascota', text: 'Vacunas con lote, laboratorio y sello, visibles desde tu cuenta.' }
];
// los 3 artículos más recientes del blog
const POSTS = BLOG_POSTS.slice(0, 3);
const waVet = whatsapp.vet();
---
<Base
  title="Alma Animal · Veterinaria, spa y petshop en Pereira"
  description="Veterinaria en Pereira: consulta, vacunas, cirugía y atención a domicilio con la Dra. Mariana Hoyos. Spa con baño antipulgas y petshop con envío gratis."
>
  <!-- ======== HÉROE ======== -->
  <div class="wrap hero-wrap">
    <header class="hero">
      <svg class="hero__curve" viewBox="0 0 1280 720" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="yg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7A6A9C"/><stop offset=".5" stop-color="#655785"/><stop offset="1" stop-color="#4D3F6C"/></linearGradient>
          <radialGradient id="glow" cx=".72" cy=".2" r=".5"><stop offset="0" stop-color="#D0BEF3" stop-opacity=".45"/><stop offset="1" stop-color="#D0BEF3" stop-opacity="0"/></radialGradient>
        </defs>
        <path d="M1280 0H900C730 0 690 170 760 330C830 490 820 720 610 720H1280Z" fill="url(#yg)"/>
        <path d="M1280 0H900C730 0 690 170 760 330C830 490 820 720 610 720H1280Z" fill="url(#glow)"/>
        <circle cx="905" cy="120" r="9" fill="#FBCFAF"/>
        <circle cx="640" cy="610" r="9" fill="#8F7FB0"/>
      </svg>

      <div class="hero__top">
        <Lockup />
        <nav class="navpill" aria-label="Principal">
          {NAV.map((n) => <a href={n.href} class={n.href === '/' ? 'is-on' : undefined} aria-current={n.href === '/' ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="hero__tools">
          <span class="hero__addr"><span class="ms" aria-hidden="true">location_on</span><span>{ADDRESS.city}<small>{ADDRESS.line}</small></span></span>
          <a class="icon-btn on-curve hide-sm" href={`tel:+${PHONES.vet.e164}`} aria-label={`Llamar al ${PHONES.vet.display}`}><span class="ms" aria-hidden="true">call</span></a>
          <CartLink class="on-curve" />
          <a class="icon-btn solid hide-sm" href="/portal" aria-label="Ingresar a mi portal"><span class="ms" aria-hidden="true">person</span></a>
          <MobileMenu />
        </div>
      </div>

      <div class="hero__copy">
        <h1>Cuidado<br /><span class="hero__h1-line">con <span class="gt">alma</span><span class="hero__seal"><Image src={heartPaper} alt="" width={96} loading="eager" /></span></span></h1>
        <p data-c="inicio.heroe.texto" set:html={TX('inicio.heroe.texto')} />
        <div class="hero__actions">
          <a class="btn btn--alma btn--lg" href="/consultorio#agendar">Agenda tu cita<span class="btn__end"><span class="ms" aria-hidden="true">arrow_forward</span></span></a>
          <a class="wa-o" href={waVet} target="_blank" rel="noopener"><WaIcon size={24} />Escríbenos</a>
        </div>
      </div>

      <!-- carrusel del equipo sobre la curva -->
      <div class="hero__team" data-carousel aria-roledescription="carrusel" aria-label="Nuestro equipo">
        <div class="team__disc" aria-hidden="true"></div>
        <div class="team__ring" aria-hidden="true"></div>
        {TEAM.map((t, i) => (
          <div class:list={['team__slide', { 'is-on': i === 0 }]} data-slide data-who={t.who} data-a={t.a} data-b={t.b} aria-hidden={i === 0 ? 'false' : 'true'}>
            <Image src={t.img} alt={t.alt} widths={[340, 480, 640]} sizes="(min-width: 1100px) 460px, 340px" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
          </div>
        ))}
        <div class="team__caption">
          <span class="team__who" data-who-label aria-live="polite">{TEAM[0].who}</span>
          <div class="team__dots">
            {TEAM.map((t, i) => <button type="button" data-dot aria-label={`Ver ${t.who}`} aria-pressed={i === 0 ? 'true' : 'false'}><span></span></button>)}
          </div>
        </div>
      </div>
      <div class="tagpill tagpill--a" aria-hidden="true"><span class="tagpill__t" data-pill-a>{TEAM[0].a}</span><span class="tagpill__d"></span></div>
      <div class="tagpill tagpill--b" aria-hidden="true"><span class="tagpill__t" data-pill-b>{TEAM[0].b}</span><span class="tagpill__d"></span></div>

      <div class="hero__side on-dark">
        <h2 data-ct="inicio.lado.titulo" set:html={TT('inicio.lado.titulo')} />
        <p data-c="inicio.lado.texto" set:html={TX('inicio.lado.texto')} />
      </div>

      <div class="hero__social">
        <span>Síguenos</span>
        {SOCIAL.instagram.map((s) => (
          <a class="social" href={s.url} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>{s.handle}</a>
        ))}
      </div>

      <nav class="hero__spaces" aria-label="Nuestros espacios">
        <a href="/consultorio" class="space space--a"><span class="ms" aria-hidden="true">stethoscope</span><b>Consultorio</b><span class="space__more">Ver servicios<span class="ms" aria-hidden="true">arrow_forward</span></span></a>
        <a href="/spa" class="space space--b"><span class="ms" aria-hidden="true">shower</span><b>Spa</b><span class="space__more">Qué incluye<span class="ms" aria-hidden="true">arrow_forward</span></span></a>
        <a href="/petshop" class="space space--c"><span class="ms" aria-hidden="true">storefront</span><b>Petshop</b><span class="space__more">Ir a la tienda<span class="ms" aria-hidden="true">arrow_forward</span></span></a>
      </nav>
    </header>
  </div>

  <!-- ======== DECLARACIÓN ======== -->
  <section class="wrap statement" aria-label="Nuestra filosofía">
    <h2 class="statement__h">
      <b class="gt">Un animalito</b>
      <span class="pill-img pill-img--paw" aria-hidden="true"><Image src={paw} alt="" width={284} /></span>
      limpio es un animalito
      <span class="pill-img pill-img--claw" aria-hidden="true"><Image src={claw} alt="" width={224} /></span>
      <b class="gt">sano</b>
    </h2>
    <p class="lead" data-c="inicio.decl.texto" set:html={TX('inicio.decl.texto')} />
  </section>

  <!-- ======== TRES ESPACIOS ======== -->
  <section class="wrap spaces" aria-labelledby="esp">
    <div class="section-head">
      <h2 id="esp" class="h-section" data-ct="inicio.espacios.titulo" set:html={TT('inicio.espacios.titulo')} />
      <p class="lead" data-c="inicio.espacios.texto" set:html={TX('inicio.espacios.texto')} />
    </div>
    <div class="spaces__grid">
      <a class="card door door--clinic" href="/consultorio">
        <span class="ms glyph" aria-hidden="true">stethoscope</span>
        <h3>Consultorio</h3>
        <p data-c="inicio.espacios.consultorio" set:html={TX('inicio.espacios.consultorio')} />
        <span class="link">Ver el consultorio<span class="ms" aria-hidden="true">arrow_forward</span></span>
      </a>
      <a class="door door--spa" href="/spa">
        <Image src={tigerDog} alt="" width={360} class="door__art" />
        <h3>Spa Alma</h3>
        <p data-c="inicio.espacios.spa" set:html={TX('inicio.espacios.spa')} />
        <span class="link">Ver el spa<span class="ms" aria-hidden="true">arrow_forward</span></span>
      </a>
      <a class="door door--shop" href="/petshop">
        <span class="ms glyph" aria-hidden="true">storefront</span>
        <h3>Petshop</h3>
        <p data-c="inicio.espacios.petshop" set:html={TX('inicio.espacios.petshop')} />
        <span class="link">Ir a la tienda<span class="ms" aria-hidden="true">arrow_forward</span></span>
      </a>
    </div>
  </section>

  <!-- ======== A DOMICILIO ======== -->
  <HomeVisit titleId="dom" cb="inicio.domicilio">
    <span class="chip-dark"><span class="ms" aria-hidden="true">home_health</span>Servicio a domicilio</span>
    <h2 id="dom" class="h-section" data-ct="inicio.domicilio.titulo" set:html={TT('inicio.domicilio.titulo')} />
    <p data-c="inicio.domicilio.texto" set:html={TX('inicio.domicilio.texto')} />
    <span class="chip-light"><span class="ms" aria-hidden="true">location_on</span><span data-c="inicio.domicilio.cobertura" set:html={TX('inicio.domicilio.cobertura')} /></span>
    <div class="actions">
      <a class="btn btn--alma btn--lg" href="/consultorio#domicilio">Agendar visita<span class="btn__end"><span class="ms" aria-hidden="true">arrow_forward</span></span></a>
      <a class="wa-o" href={whatsapp.vet('Hola, Alma Animal. ¿Atienden a domicilio en mi barrio?')} target="_blank" rel="noopener"><WaIcon size={24} />Preguntar cobertura</a>
    </div>
  </HomeVisit>

  <!-- ======== NOSOTROS ======== -->
  <section id="nosotros" class="wrap" aria-labelledby="nos">
    <div class="about">
      <div class="about__portrait">
        <div class="about__ring" aria-hidden="true"></div>
        <div class="about__photo"><Image src={mariana} alt="Retrato de la Dra. Mariana Hoyos con un gato atigrado" widths={[320, 480]} sizes="(min-width: 768px) 420px, 280px" /></div>
        <div class="about__seal" role="img" aria-label="Sello de Alma Animal, MVZ TP 51206">
          <svg viewBox="0 0 132 132" aria-hidden="true"><defs><path id="ring" d="M66 66 m-50 0 a50 50 0 1 1 100 0 a50 50 0 1 1 -100 0"/></defs><circle cx="66" cy="66" r="63" fill="#FEF7FE" stroke="currentColor" stroke-width="2.5"/><circle cx="66" cy="66" r="38" fill="none" stroke="currentColor" stroke-width="1"/><text font-family="Alan Sans, sans-serif" font-size="10.5" font-weight="700" letter-spacing="2.6" fill="currentColor"><textPath href="#ring">ALMA ANIMAL · PEREIRA · MVZ TP 51206 ·</textPath></text></svg>
          <span><Image src={heartPaper} alt="" width={96} /></span>
        </div>
      </div>
      <div class="about__copy">
        <h2 id="nos" class="h-section about__name">Dra. Mariana<br /><b class="gt">Hoyos Giraldo</b></h2>
        <p class="serif about__title">{DOCTOR.title} · {DOCTOR.tp}</p>
        <p class="lead" data-c="inicio.nosotros.historia" hidden={!CAMPOS['inicio.nosotros.historia'].def} set:html={TX('inicio.nosotros.historia')} />
        <ul class="about__tags"><li>Medicina preventiva</li><li>Cirugía</li><li>Spa y peluquería</li></ul>
        <div class="about__actions">
          <a class="btn" href="/nosotros">Conoce al equipo</a>
          <a class="btn btn--outlined" href="https://instagram.com/vet_marianahoyos" target="_blank" rel="noopener">@vet_marianahoyos</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== POR QUÉ ======== -->
  <section class="wrap reasons" aria-labelledby="pq" data-cb="inicio.porque">
    <h2 id="pq" class="h-section" data-ct="inicio.porque.titulo" set:html={TT('inicio.porque.titulo')} />
    <ul class="reasons__grid">
      {REASONS.map((r) => (
        <li>
          <span class="reasons__n">{r.n}{r.suffix && <small>{r.suffix}</small>}</span>
          <b>{r.title}</b>
          <p>{r.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ======== BLOG ======== -->
  <section id="blog" class="wrap blog" aria-labelledby="bl" data-cb="inicio.blog">
    <div class="section-head section-head--row">
      <h2 id="bl" class="h-section" data-ct="inicio.blog.titulo" set:html={TT('inicio.blog.titulo')} />
      <a class="link" href="/blog">Leer el blog<span class="ms" aria-hidden="true">arrow_forward</span></a>
    </div>
    <div class="blog__grid">
      {POSTS.map((p) => (
        <a class="card post" href={postUrl(p)}>
          <span class="post__cover" style={`background: ${p.cover.bg};`}>{p.cover.foto ? <img class="foto-cover" src={p.cover.foto} alt="" loading="lazy" decoding="async" /> : <Image src={p.cover.img} alt="" width={300} style={`width: ${Math.round(p.cover.w * 100)}%; max-width: 150px;`} />}</span>
          <span class="post__body">
            <span class="post__meta">{p.cat} · {p.min} min{BLOG_DEMO && ' · Artículo de ejemplo'}</span>
            <span class="serif post__title">{p.title}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ======== WHATSAPP ======== -->
  <WaStrip href={waVet} text="Agenda, pregunta por un producto o pide el precio del baño. Te responde el equipo de Alma Animal." />
</Base>

<script>
  // Carrusel del equipo: cambia cada 5 s, se pausa al pasar el mouse o con movimiento reducido.
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const who = root.querySelector<HTMLElement>('[data-who-label]');
    const pillA = document.querySelector<HTMLElement>('[data-pill-a]');
    const pillB = document.querySelector<HTMLElement>('[data-pill-b]');
    let i = 0;
    let timer: number | undefined;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => { s.classList.toggle('is-on', k === i); s.setAttribute('aria-hidden', k === i ? 'false' : 'true'); });
      dots.forEach((d, k) => d.setAttribute('aria-pressed', k === i ? 'true' : 'false'));
      const s = slides[i];
      if (who) who.textContent = s.dataset.who ?? '';
      if (pillA) pillA.textContent = s.dataset.a ?? '';
      if (pillB) pillB.textContent = s.dataset.b ?? '';
    };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = () => { if (!reduce) timer = window.setInterval(() => show(i + 1), 5000); };
    const stop = () => window.clearInterval(timer);
    dots.forEach((d, k) => d.addEventListener('click', () => { stop(); show(k); start(); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    start();
  }
</script>

<style>
  /* ---------- HÉROE · celular primero ---------- */
  .hero-wrap { padding-top: 12px; }
  .hero { position: relative; display: flex; flex-direction: column; gap: 18px; padding: 14px; border-radius: var(--r-lg); background: var(--wash), #fff; box-shadow: 0 0 0 1px var(--line); isolation: isolate; }
  .hero__curve { display: none; }
  .hero__top { order: 1; display: flex; align-items: center; gap: 10px; }
  .navpill { display: none; }
  .hero__tools { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .hero__addr { display: none; }
  .hide-sm { display: none; }
  .icon-btn.solid { background: #fff; color: var(--primary); }

  .hero__copy { order: 2; display: flex; flex-direction: column; gap: 16px; padding: 4px 4px 0; }
  .hero h1 { font-size: clamp(42px, 12vw, 100px); font-weight: 700; line-height: .95; letter-spacing: -.045em; }
  .hero__h1-line { display: inline-flex; align-items: center; gap: .14em; }
  .hero__seal { width: .7em; height: .7em; border-radius: 50%; background: var(--grad-primary); display: inline-grid; place-items: center; margin-top: .1em; box-shadow: var(--shadow-1); }
  .hero__seal img { width: 62%; height: auto; }
  .hero__copy p { font-size: 17px; line-height: 1.55; color: var(--ink-muted); max-width: 34ch; }
  .hero__copy p :global(b) { color: var(--ink); font-weight: 600; }
  .hero__actions { display: flex; flex-direction: column; gap: 12px; }
  .hero__actions > * { width: 100%; }

  .hero__team { order: 3; position: relative; height: 340px; border-radius: 22px 22px 0 0; background: var(--grad-primary); overflow: hidden; }
  .team__disc { position: absolute; left: 50%; top: 30px; width: 260px; height: 260px; margin-left: -130px; border-radius: 50%; background: linear-gradient(90deg, #FBCFAF 50%, #D1C1DD 50%); box-shadow: 0 0 0 14px rgb(255 255 255 / .2); }
  .team__ring { position: absolute; left: 50%; top: 12px; width: 296px; height: 296px; margin-left: -148px; border-radius: 50%; border: 1px dashed rgb(255 255 255 / .6); }
  .team__slide { position: absolute; inset: 0; opacity: 0; transition: opacity .8s var(--ease); }
  .team__slide.is-on { opacity: 1; }
  .team__slide img { position: absolute; left: 50%; bottom: 0; height: 320px; width: auto; max-width: none; transform: translateX(-50%); }
  .team__caption { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 4px; z-index: 4; }
  .team__who { font: 600 14px/1 var(--font-sans); white-space: nowrap; padding: 10px 16px; border-radius: 999px; background: rgb(255 255 255 / .95); color: var(--ink); box-shadow: 0 1px 3px rgb(54 41 84 / .2); }
  .team__dots { display: flex; gap: 2px; }
  .team__dots button { width: 34px; height: 24px; border: 0; padding: 0 5px; background: transparent; cursor: pointer; display: grid; place-items: center; }
  .team__dots span { display: block; width: 14px; height: 6px; border-radius: 999px; background: rgb(255 255 255 / .55); transition: width .3s var(--ease-out), background .3s; }
  .team__dots [aria-pressed="true"] span { width: 26px; background: #fff; }

  .tagpill { display: none; }
  .hero__side { order: 4; margin-top: -18px; padding: 6px 20px 24px; border-radius: 0 0 22px 22px; background: var(--grad-primary); color: #fff; display: flex; flex-direction: column; gap: 10px; }
  .hero__side h2 { font-size: 24px; font-weight: 400; line-height: 1.15; letter-spacing: -.02em; }
  .hero__side h2 :global(b) { font-weight: 700; }
  .hero__side p { font-size: 16px; line-height: 1.5; color: rgb(255 255 255 / .88); }
  .hero__side p :global(b) { color: #fff; font-weight: 600; }
  .hero__social { display: none; }

  .hero__spaces { order: 5; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; padding: 6px; border-radius: 22px; background: #fff; box-shadow: 0 0 0 1px var(--line-soft); }
  .space { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 14px 6px; border-radius: 16px; text-decoration: none; text-align: center; transition: transform .25s var(--ease-out); }
  .space:hover { transform: translateY(-2px); }
  .space .ms { font-size: 26px; }
  .space b { font: 600 14px/1.2 var(--font-sans); }
  .space__more { display: none; }
  .space--a { background: var(--surface-3); color: var(--ink); }
  .space--a .ms { color: var(--primary); }
  .space--b { background: var(--grad-primary); color: #fff; }
  .space--b:hover { color: #fff; }
  .space--c { background: var(--grad-alma); color: #362954; }
  .space--c:hover { color: #362954; }

  /* ---------- HÉROE · tableta ---------- */
  @media (min-width: 768px) {
    .hero-wrap { padding-top: 24px; }
    .hero { padding: 22px; gap: 22px; border-radius: var(--r-xl); }
    .hero__actions { flex-direction: row; flex-wrap: wrap; }
    .hero__actions > * { width: auto; }
    .hero__team { height: 420px; }
    .team__disc { width: 330px; height: 330px; margin-left: -165px; }
    .team__ring { width: 370px; height: 370px; margin-left: -185px; }
    .team__slide img { height: 400px; }
    .hero__side { padding: 6px 28px 28px; }
    .space { flex-direction: row; justify-content: center; padding: 16px; }
    .space b { font-size: 16px; }
  }

  /* ---------- HÉROE · escritorio: la curva yin-yang ---------- */
  @media (min-width: 1100px) {
    .hero { display: block; height: 720px; padding: 0; overflow: hidden; }
    .hero__curve { display: block; position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
    .hero__top { position: absolute; top: 28px; left: 40px; right: 32px; gap: 24px; z-index: 6; }
    .navpill { display: flex; gap: 2px; padding: 5px; border-radius: 999px; background: rgb(255 255 255 / .85); box-shadow: 0 0 0 1px var(--line); }
    .navpill a { font: 600 15px/1 var(--font-sans); color: var(--ink-muted); text-decoration: none; padding: 11px 14px; border-radius: 999px; transition: background .15s; }
    .navpill a:hover { background: var(--surface-3); color: var(--ink); }
    .navpill a.is-on { background: var(--ink); color: #fff; }
