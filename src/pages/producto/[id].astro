---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import WaIcon from '../../components/WaIcon.astro';
import ProductCard from '../../components/ProductCard.astro';
import SalesBuzz from '../../components/SalesBuzz.astro';
import { whatsapp } from '../../data/site';
import { DEMO, TAGS, PRODUCTS, SHIPPING, GIFT, money, stockOf, catLabel, forLabel, cartPayload, type Product } from '../../data/shop';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props as { p: Product };

// la última palabra del nombre va con el degradado de la marca
const words = p.name.split(' ');
const head = words.slice(0, -1).join(' ');
const last = words[words.length - 1];
const start = p.variants.find((v) => v.stock > 0) ?? p.variants[0];
const multi = p.variants.length > 1;
const soldOut = stockOf(p) === 0;
const kind = p.variantKind ?? 'Presentación';
const ask = whatsapp.shop(`Hola, Alma Animal. Tengo una pregunta sobre ${p.name}. ¿Es el indicado para mi mascota?`);
// relacionados: primero la misma categoría, luego lo más vendido
const related = PRODUCTS.filter((x) => x.id !== p.id)
  .sort((a, b) => Number(b.cat === p.cat) - Number(a.cat === p.cat) || b.sold - a.sold)
  .slice(0, 4);
const subLabel = (v: Product['variants'][number]) => (v.stock === 0 ? 'Agotado' : 3 >= v.stock ? `${money(v.price)} · últimas ${v.stock}` : money(v.price));
---
<Base
  title={`${p.name} · Petshop Alma Animal`}
  description={`${p.text} Envío gratis en Pereira y Dosquebradas, y a toda Colombia desde ${money(SHIPPING.freeFrom)}.`}
  waMessage={`Hola, Alma Animal. Tengo una pregunta sobre ${p.name}.`}
  waArea="shop"
>
  <SiteHeader slot="top" />

  <!-- ======== ENVÍO GRATIS: se llena con lo que hay en el carrito ======== -->
  <div class="wrap">
    <div class="shipline" role="status" data-shipline>
      <span class="ms" aria-hidden="true">local_shipping</span>
      <span class="shipline__txt" data-ship-msg>Envío gratis a toda Colombia desde <b>{money(SHIPPING.freeFrom)}</b></span>
      <span class="shipline__bar" aria-hidden="true"><i data-ship-bar data-free-fill></i></span>
      <span class="shipline__note">En Pereira y Dosquebradas siempre es gratis</span>
    </div>
  </div>

  <nav class="wrap crumbs" aria-label="Estás en">
    <a href="/petshop">Petshop</a><span class="ms" aria-hidden="true">chevron_right</span>
    <a href={`/petshop#${p.cat}`}>{catLabel(p.cat)}</a><span class="ms" aria-hidden="true">chevron_right</span>
    <span aria-current="page">{p.name}</span>
  </nav>

  <!-- ======== PRODUCTO ======== -->
  <section class="wrap product" aria-labelledby="pn">
    <div class="gallery">
      <div class="gallery__main" style={`background:${p.tone}`}>
        <span class="ms" aria-hidden="true">{p.icon}</span>
        <span class:list={['stock', { low: !soldOut && 3 >= stockOf(p), out: soldOut }]} data-stock-pill>{soldOut ? 'Agotado' : 'En stock'}</span>
      </div>
    </div>

    <div class="info" data-info>
      <div class="info__meta">
        <span class="info__cat">{catLabel(p.cat)} · {forLabel(p)}</span>
        {p.tag && <span class:list={['tag', TAGS[p.tag].tone]}>{TAGS[p.tag].label}</span>}
      </div>
      <h1 id="pn">{head} <b class="gt">{last}</b></h1>
      <div class="price">
        <b data-price>{money(start.price)}</b>
        <s data-was hidden={!start.was}>{start.was ? money(start.was) : ''}</s>
        {DEMO && <span class="price__note">Precio de ejemplo</span>}
      </div>
      <p class="info__text">{p.text}</p>

      {multi && (
        <fieldset class="vars">
          <legend>{kind}: <span data-var-name>{start.label}</span></legend>
          <div class="vars__list">
            {p.variants.map((v) => (
              <label class:list={['var', { 'is-out': v.stock === 0 }]}>
                <input type="radio" name="variante" value={v.id} checked={v === start}
                  data-label={v.label} data-price={v.price} data-was={v.was ?? ''} data-stock={v.stock}
                  data-item={JSON.stringify(cartPayload(p, v))} />
                <b>{v.label}</b>
                <span>{subLabel(v)}</span>
              </label>
            ))}
          </div>
        </fieldset>
      )}
      {!multi && <span hidden data-single data-label={start.label} data-price={start.price} data-was={start.was ?? ''} data-stock={start.stock} data-item={JSON.stringify(cartPayload(p, start))}></span>}
      <p class="soldout" data-soldout hidden={start.stock > 0}>
        {multi ? `Esta ${kind.toLowerCase()} está agotada.` : 'Este producto está agotado.'}
        <a href="#" data-notify target="_blank" rel="noopener">Avísame por WhatsApp cuando llegue</a>
      </p>

      <dl class="specs">
        {multi && <div><dt>{kind}</dt><dd data-var-name>{start.label}</dd></div>}
        <div><dt>Para</dt><dd>{forLabel(p)}</dd></div>
        {p.specs?.map(([k, v]) => <div class:list={{ wide: v.length > 28 }}><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>

      <div class="buy" data-buy>
        <span class="qty" role="group" aria-label="Cantidad">
          <button type="button" aria-label="Quitar uno" data-dec>−</button>
          <output aria-live="polite" data-qty>1</output>
          <button type="button" aria-label="Agregar uno" data-inc>+</button>
        </span>
        <button class="cta" type="button" data-cta><span class="ms" aria-hidden="true">shopping_bag</span><span data-cta-txt>Agregar · {money(start.price)}</span></button>
      </div>
      <div class="added" role="status" data-added hidden>
        <span><span class="ms" aria-hidden="true">check_circle</span><span data-added-txt>Agregado al carrito</span></span>
        <a href="/carrito">Ver carrito</a>
      </div>

      <a class="wa-o" href={ask} target="_blank" rel="noopener"><WaIcon size={22} />¿Es el indicado? Pregúntale a la doctora</a>

      <p class="gift" data-gift><span class="ms" aria-hidden="true">redeem</span><span data-gift-txt>En compras desde <b>{money(GIFT.from)}</b> te llevas un <b>obsequio</b>.</span></p>
      <ul class="perks">
        <li><span class="ms" aria-hidden="true">local_shipping</span>Envío gratis en Pereira y Dosquebradas</li>
        <li><span class="ms" aria-hidden="true">public</span>Gratis a toda Colombia en compras desde {money(SHIPPING.freeFrom)}</li>
        <li><span class="ms" aria-hidden="true">bolt</span>Envío prioritario por {money(SHIPPING.priority)}</li>
      </ul>
    </div>
  </section>

  <!-- ======== RELACIONADOS ======== -->
  <section class="wrap related" aria-labelledby="rel">
    <h2 id="rel" class="h-section">Te puede <b class="gt">interesar</b></h2>
    <div class="related__grid">
      {related.map((r, i) => <ProductCard p={r} i={i} />)}
    </div>
    {DEMO && <p class="related__note">Productos y precios de ejemplo.</p>}
  </section>

  <SalesBuzz />
</Base>

<script>
  import { cart, progress, money } from '../../scripts/cart';

  const info = document.querySelector<HTMLElement>('[data-info]')!;
  const radios = [...info.querySelectorAll<HTMLInputElement>('input[name="variante"]')];
  const qtyOut = info.querySelector<HTMLOutputElement>('[data-qty]')!;
  const cta = info.querySelector<HTMLButtonElement>('[data-cta]')!;
  const ctaTxt = info.querySelector<HTMLElement>('[data-cta-txt]')!;
  const soldout = info.querySelector<HTMLElement>('[data-soldout]')!;
  const notify = info.querySelector<HTMLAnchorElement>('[data-notify]')!;
  const added = info.querySelector<HTMLElement>('[data-added]')!;
  const SHOP = '573017925910';
  let qty = 1;

  const current = (): DOMStringMap => {
    const r = radios.find((x) => x.checked);
    if (r) return r.dataset;
    // sin variantes, los datos vienen de un elemento oculto
    return info.querySelector<HTMLElement>('[data-single]')!.dataset;
  };

  const paint = () => {
    const d = current();
    const price = Number(d.price), stock = Number(d.stock);
    const out = stock === 0;
    qty = Math.max(1, Math.min(qty, stock || 1));
    qtyOut.textContent = String(qty);
    info.querySelector('[data-price]')!.textContent = money(price);
    const was = info.querySelector<HTMLElement>('[data-was]')!;
    was.hidden = !d.was; was.textContent = d.was ? money(Number(d.was)) : '';
    info.querySelectorAll('[data-var-name]').forEach((el) => { el.textContent = d.label!; });
    soldout.hidden = !out;
    const item = JSON.parse(d.item!);
    notify.href = `https://wa.me/${SHOP}?text=${encodeURIComponent(`Hola, Alma Animal. Avísenme cuando llegue ${item.name}${radios.length ? ' · ' + d.label : ''}.`)}`;
    cta.disabled = out;
    ctaTxt.textContent = out ? 'Agotado' : `Agregar · ${money(price * qty)}`;
    info.querySelector<HTMLButtonElement>('[data-dec]')!.disabled = qty <= 1 || out;
    info.querySelector<HTMLButtonElement>('[data-inc]')!.disabled = qty >= stock || out;
  };

  radios.forEach((r) => r.addEventListener('change', () => { qty = 1; added.hidden = true; paint(); }));
  info.querySelector('[data-dec]')!.addEventListener('click', () => { qty--; paint(); });
  info.querySelector('[data-inc]')!.addEventListener('click', () => { qty++; paint(); });
  cta.addEventListener('click', () => {
    const d = current();
    cart.add(JSON.parse(d.item!), qty);
    info.querySelector('[data-added-txt]')!.textContent = `${qty > 1 ? qty + ' agregados' : 'Agregado'} al carrito`;
    added.hidden = false;
    cta.classList.remove('hop'); void cta.offsetWidth; cta.classList.add('hop');
  });

  // envío gratis y obsequio según el carrito
  const shipMsg = document.querySelector<HTMLElement>('[data-ship-msg]')!;
  const shipBar = document.querySelector<HTMLElement>('[data-ship-bar]')!;
  const gift = document.querySelector<HTMLElement>('[data-gift-txt]')!;
  const paintCart = () => {
    const sub = cart.subtotal();
    if (!sub) return;
    const p = progress(sub);
    shipMsg.innerHTML = p.toFree > 0 ? `Te faltan <b>${money(p.toFree)}</b> para envío gratis<span class="hide-sm"> a toda Colombia</span>` : '<b>¡Ya tienes envío gratis</b><span class="hide-sm"> a toda Colombia</span>!';
    shipBar.style.width = p.freePct + '%';
    shipBar.classList.toggle('is-full', p.freePct >= 100);
    gift.innerHTML = p.toGift > 0 ? `Agrega <b>${money(p.toGift)}</b> más a tu carrito y llévate un <b>obsequio</b>.` : '¡Tu pedido ya lleva un <b>snack dental</b> de obsequio!';
  };
  paintCart();
  cart.onChange(paintCart);
  paint();
</script>

<style>
  /* ---------- ENVÍO GRATIS ---------- */
  .shipline { position: relative; overflow: hidden; display: flex; align-items: center; gap: 10px; padding: 12px 16px 14px; border-radius: 999px; background: var(--surface-3); }
  .shipline > .ms { font-size: 20px; color: var(--primary); }
  .shipline__txt { flex: 1; min-width: 0; font: 500 14.5px/1.3 var(--font-sans); }
  .shipline__txt :global(.hide-sm) { display: none; }
  .shipline__bar { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: rgb(101 87 133 / .12); }
  .shipline__bar i { display: block; width: 0; height: 100%; background: var(--grad-primary); transition: width .8s var(--ease); }
  .shipline__note { display: none; }
  @media (min-width: 900px) {
    .shipline { gap: 16px; padding: 14px 22px; }
    .shipline > .ms { font-size: 24px; }
    .shipline__txt { flex: none; font-size: 16px; }
    .shipline__txt :global(.hide-sm) { display: inline; }
    .shipline__bar { position: static; flex: 1; min-width: 80px; height: 8px; border-radius: 999px; overflow: hidden; background: #E6E1E7; }
    .shipline__bar i { border-radius: 999px; }
    .shipline__note { display: inline; font-size: 15px; color: var(--ink-muted); white-space: nowrap; }
  }

  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; padding-top: 18px; padding-bottom: 18px; font: 500 14px/1.3 var(--font-sans); color: var(--ink-muted); }
  .crumbs a { color: var(--primary); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs .ms { font-size: 16px; }
  .crumbs [aria-current] { color: var(--ink); }

  /* ---------- PRODUCTO ---------- */
  .product { display: grid; gap: 24px; align-items: start; padding-bottom: var(--section); }
  .gallery__main { position: relative; aspect-ratio: 1; border-radius: var(--r-md); display: grid; place-items: center; color: rgb(54 41 84 / .5); overflow: hidden; }
  .gallery__main > .ms { font-size: 120px; }
  .stock { position: absolute; top: 16px; left: 16px; font: 600 13px/1 var(--font-sans); padding: 8px 12px; border-radius: 999px; background: #B8F1B9; color: #1D5128; }
  .stock.low { background: #FFDDB2; color: #624000; }
  .stock.out { background: #fff; color: var(--ink-muted); }

  .info { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .info__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; }
  .info__cat { font: 600 15px/1.3 var(--font-sans); color: var(--primary); margin-right: 4px; }
  .tag { font: 600 12.5px/1.2 var(--font-sans); padding: 6px 10px; border-radius: 999px; background: #fff; color: var(--ink); box-shadow: 0 0 0 1px var(--line-soft), 0 1px 2px rgb(54 41 84 / .1); }
  .tag.sale { color: #910809; }
  .info h1 { font-size: clamp(30px, 8vw, 44px); font-weight: 400; line-height: 1.08; letter-spacing: -.03em; }
  .info h1 b { font-weight: 700; }
  .price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; }
  .price b { font: 700 32px/1 var(--font-sans); font-variant-numeric: tabular-nums; }
  .price s { font-size: 18px; color: var(--ink-muted); }
  .price s[hidden] { display: none; }
  .price__note { font-size: 14px; color: var(--ink-muted); }
  .info__text { font-size: 17px; line-height: 1.6; color: var(--ink-muted); max-width: 52ch; }

  .vars { margin: 0; padding: 0; border: 0; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .vars legend { float: left; width: 100%; padding: 0; margin-bottom: 10px; font: 600 16px/1.3 var(--font-sans); }
  .vars legend span { font-weight: 400; color: var(--ink-muted); }
  .vars__list { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 10px; }
  .var { position: relative; display: flex; flex-direction: column; gap: 5px; padding: 12px 14px; border-radius: 16px; background: #fff; box-shadow: 0 0 0 1px var(--line); cursor: pointer; transition: box-shadow .15s, background .15s; }
  .var:hover { box-shadow: 0 0 0 1px var(--primary-soft); }
  .var input { position: absolute; opacity: 0; pointer-events: none; }
  .var b { font: 600 16px/1.2 var(--font-sans); }
  .var span { font: 400 14px/1.25 var(--font-sans); color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .var:has(input:checked) { background: var(--surface-2); box-shadow: 0 0 0 2px var(--primary); }
  .var:has(input:focus-visible) { outline: 3px solid var(--primary); outline-offset: 3px; }
  .var.is-out b { text-decoration: line-through; color: var(--ink-muted); }
  .var.is-out span { color: #910809; }
  .soldout { font-size: 15px; line-height: 1.5; color: var(--ink-muted); }
  .soldout[hidden] { display: none; }
  .soldout a { font-weight: 600; }

  .specs { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; border-radius: 20px; overflow: hidden; background: var(--line); box-shadow: 0 0 0 1px var(--line); }
  .specs div { background: #fff; padding: 12px 14px; min-width: 0; }
  .specs div.wide { grid-column: 1 / -1; }
  /* si queda una sola celda al final, ocupa la fila completa */
  .specs div:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .specs dt { font: 500 14px/1.3 var(--font-sans); color: var(--ink-muted); }
  .specs dd { margin: 4px 0 0; font: 600 16px/1.35 var(--font-sans); }

  .buy { display: flex; align-items: center; gap: 10px; }
  .qty { display: inline-flex; align-items: center; height: 52px; border: 1px solid var(--line); border-radius: 999px; background: #fff; flex: none; }
  .qty button { width: 44px; height: 50px; border: 0; border-radius: 999px; background: transparent; color: var(--primary); font: 500 24px/1 var(--font-sans); cursor: pointer; }
  .qty button:hover:not(:disabled) { background: var(--surface-3); }
  .qty button:disabled { color: #B9B2C0; cursor: default; }
  .qty output { min-width: 26px; text-align: center; font: 600 17px/1 var(--font-sans); font-variant-numeric: tabular-nums; }
  /* agregar al carrito: el durazno de la marca y un pequeño salto cada pocos segundos */
  .cta { flex: 1; min-width: 0; display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 52px; padding: 0 14px; border: 0; border-radius: 999px; background: #F0BC95; color: #48290D; font: 600 16px/1 var(--font-sans); font-variant-numeric: tabular-nums; cursor: pointer; box-shadow: 0 2px 6px rgb(176 120 80 / .25); transition: background .2s, box-shadow .2s; animation: cta-hop 5s var(--ease) 2s infinite; }
  .cta:hover { background: #E8AC80; box-shadow: 0 6px 14px rgb(176 120 80 / .3); animation-play-state: paused; }
  .cta:active { transform: scale(.98); }
  .cta:disabled { background: var(--surface-3); color: var(--ink-muted); box-shadow: none; cursor: default; animation: none; }
  .cta.hop { animation: cta-yes .4s var(--ease-out); }
  @keyframes cta-hop { 0%, 88%, 100% { transform: none; } 92% { transform: translateY(-4px); } 96% { transform: translateY(0); } }
  @keyframes cta-yes { 50% { transform: scale(1.04); } }
  @media (prefers-reduced-motion: reduce) { .cta, .cta.hop { animation: none; } }
  .added { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; padding: 12px 16px; border-radius: 16px; background: #B8F1B9; color: #1D5128; font: 500 16px/1.3 var(--font-sans); }
  .added[hidden] { display: none; }
  .added > span { display: flex; align-items: center; gap: 8px; }
  .added .ms { font-variation-settings: "FILL" 1; }
  .added a { color: #1D5128; font-weight: 600; }

  .gift { display: flex; gap: 10px; align-items: center; padding: 14px 16px; border-radius: 16px; background: var(--grad-alma); color: #362954; font: 500 16px/1.4 var(--font-sans); }
  .gift .ms { font-size: 24px; }
  .perks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 16px; line-height: 1.4; }
  .perks li { display: flex; gap: 10px; align-items: center; }
  .perks .ms { color: var(--primary); }

  /* en celular, cantidad y "Agregar" quedan fijos abajo */
  @media (max-width: 899px) {
    .buy { position: fixed; left: 0; right: 0; bottom: 0; z-index: 38; padding: 12px var(--gutter) max(12px, env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -1px 0 var(--line-soft), 0 -8px 20px rgb(54 41 84 / .08); }
    :global(html) { --dock: 76px; }
    :global(.fab-wa) { display: none !important; }
    :global(main) { padding-bottom: 76px; }
  }
  @media (min-width: 900px) {
    .product { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 48px; }
    .gallery { position: sticky; top: 24px; }
    .gallery__main { border-radius: 32px; }
    .gallery__main > .ms { font-size: 160px; }
    .info { gap: 22px; }
    .price b { font-size: 34px; }
    .info__text { font-size: 18px; }
    .specs div { padding: 14px 16px; }
    .specs dd { font-size: 17px; }
    .qty { height: 56px; }
    .qty button { width: 50px; height: 54px; }
    .cta { height: 56px; font-size: 18px; padding: 0 24px; }
    .wa-o { align-self: flex-start; }
  }

  /* ---------- RELACIONADOS ---------- */
  .related { display: flex; flex-direction: column; gap: 20px; padding-bottom: var(--section); }
  .related__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .related__note { font-size: 14px; color: var(--ink-muted); }
  @media (min-width: 900px) { .related__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; } }
</style>
