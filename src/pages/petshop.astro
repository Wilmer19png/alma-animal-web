---
import { TX, TT, CAMPOS } from '../data/contenido';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WaIcon from '../components/WaIcon.astro';
import WaStrip from '../components/WaStrip.astro';
import Steps from '../components/Steps.astro';
import SalesBuzz from '../components/SalesBuzz.astro';
import { whatsapp } from '../data/site';
import '../styles/tienda.css';
import { Image } from 'astro:assets';
import lobo from '../assets/identidad/lobo.webp';
import { CATEGORIES, BUY_STEPS, SHIPPING, money, CIUDADES } from '../data/shop';

// al entrar: las categorías en grande (con color e ícono). Las tres últimas agrupan por etiqueta.
const TILES = [
  { id: 'alimento', label: 'Alimento', icon: 'set_meal', bg: '#FFDCC3', ic: '#B9764A' },
  { id: 'higiene', label: 'Higiene', icon: 'soap', bg: '#EADDFF', ic: '#655785' },
  { id: 'snacks', label: 'Snacks', icon: 'cookie', bg: '#FBCFAF', ic: '#9C5A2E' },
  { id: 'accesorios', label: 'Accesorios', icon: 'pets', bg: '#D1C1DD', ic: '#4D3F6C' },
  { id: 'juguetes', label: 'Juguetes', icon: 'sports_baseball', bg: '#E8C6CF', ic: '#8C4B5E' },
  { id: 'dra', label: 'Lo recomienda la Dra.', icon: 'stethoscope', bg: '#B8F1B9', ic: '#1D7A37' },
  { id: 'oferta', label: 'Ofertas', icon: 'sell', bg: '#FFDAD5', ic: '#BA1A1A' },
  { id: 'nuevo', label: 'Lo nuevo', icon: 'new_releases', bg: '#F2ECF2', ic: '#655785' }
];
const ESPECIAL = TILES.slice(5);

const waShop = whatsapp.shop('Hola, Alma Animal. Tengo una pregunta sobre la tienda.');
---
<Base
  title="Petshop · Alma Animal"
  description={`Alimento, higiene y accesorios recomendados por la doctora. Envío gratis en ${CIUDADES}, y a toda Colombia desde ${money(SHIPPING.freeFrom)}.`}
  waMessage="Hola, Alma Animal. Tengo una pregunta sobre la tienda."
  waArea="shop"
>
  <SiteHeader slot="top" />

  <!-- ======== CABECERA DE TIENDA ======== -->
  <div class="wrap">
    <header class="shophead">
      <div class="shophead__copy">
        <a class="back" href="/"><span class="ms" aria-hidden="true">arrow_back</span>Inicio</a>
        <h1>Pet<span>shop</span></h1>
        <p data-c="petshop.heroe.texto" set:html={TX('petshop.heroe.texto')} />
        <ul class="perks">
          <li><span class="ms" aria-hidden="true">local_shipping</span>Envío gratis en {CIUDADES}</li>
          <li><span class="ms" aria-hidden="true">public</span>Gratis a toda Colombia desde {money(SHIPPING.freeFrom)}</li>
          {SHIPPING.priority > 0 && <li><span class="ms" aria-hidden="true">bolt</span>Envío prioritario +{money(SHIPPING.priority)}</li>}
        </ul>
      </div>
      <!-- empaques ilustrados (se cambian por fotos recortadas cuando las tengamos) -->
      <div class="shelf" aria-hidden="true">
        <span class="pk pk--bag"><span class="ms">set_meal</span></span>
        <span class="pk pk--bottle"><span class="ms">soap</span></span>
        <span class="pk pk--box"><span class="ms">cookie</span></span>
        <span class="pk pk--ball"><span class="ms">sports_baseball</span></span>
        <span class="pk pk--tag"><span class="ms">loyalty</span></span>
        <Image src={lobo} alt="" width={260} class="shelf__lobo" loading="eager" />
      </div>
    </header>
  </div>

  <!-- ======== ¿QUÉ BUSCAS? (al entrar a la tienda) ======== -->
  <section class="wrap cathome" aria-labelledby="qb" data-home>
    <div class="cathome__head">
      <div class="cathome__txt">
        <h2 id="qb" class="h-section">¿Qué estás <b class="gt">buscando?</b></h2>
        <p class="lead">Elige una categoría. Si no sabes cuál, escríbenos y la doctora te recomienda.</p>
      </div>
      <div class="species" role="group" aria-label="Para quién">
        <button type="button" data-esp="" aria-pressed="true"><span class="ms" aria-hidden="true">pets</span>Todos</button>
        <button type="button" data-esp="perro" aria-pressed="false"><span class="ms" aria-hidden="true">sound_detection_dog_barking</span>Perros</button>
        <button type="button" data-esp="gato" aria-pressed="false"><span class="ms" aria-hidden="true">cruelty_free</span>Gatos</button>
      </div>
    </div>
    <div class="tiles">
      {TILES.map((t) => (
        <a class="tile" href={`#${t.id}`} data-tile={t.id} style={`--tile-bg:${t.bg};--tile-ic:${t.ic}`}>
          <span class="ms tile__ic" aria-hidden="true">{t.icon}</span>
          {t.id === 'oferta' && <span class="tile__off" data-off-max hidden></span>}
          <b>{t.label}</b>
          <span class="tile__n"><span data-tile-n>&nbsp;</span><span class="ms" aria-hidden="true">arrow_forward</span></span>
        </a>
      ))}
    </div>
    <div class="tops" data-tops-wrap hidden>
      <div class="tops__head">
        <h3><span class="ms" aria-hidden="true">local_fire_department</span>Lo más vendido</h3>
        <a class="btn btn--outlined" href="#todo">Ver todos los productos</a>
      </div>
      <div class="grid tops__grid" data-tops></div>
    </div>
  </section>

  <!-- ======== DENTRO DE UNA CATEGORÍA ======== -->
  <nav class="wrap crumbs-cat" aria-label="Estás en" data-browse hidden>
    <a href="#" data-home-link><span class="ms" aria-hidden="true">arrow_back</span>Todas las categorías</a>
    <span class="ms" aria-hidden="true">chevron_right</span><b data-crumb>Todos los productos</b>
  </nav>

  <!-- ======== CATEGORÍAS + BÚSQUEDA ======== -->
  <div class="wrap toolbar" data-browse hidden>
    <div class="cats" role="group" aria-label="Categorías">
      <button class="chip is-on" type="button" data-cat="" aria-pressed="true">Todo</button>
      {CATEGORIES.map((c) => <button class="chip" type="button" data-cat={c.id} aria-pressed="false">{c.label}</button>)}
      {ESPECIAL.map((c) => <button class="chip" type="button" data-cat={c.id} aria-pressed="false">{c.label}</button>)}
    </div>
    <label class="search">
      <span class="ms" aria-hidden="true">search</span>
      <span class="sr-only">Buscar productos</span>
      <input type="search" placeholder="Buscar en la tienda" data-search autocomplete="off" />
    </label>
  </div>

  <!-- ======== FILTROS | PRODUCTOS | CARRITO ======== -->
  <section class="wrap catalog" aria-label="Catálogo" data-browse hidden>
    <aside class="filters" id="filtros" aria-label="Filtros" data-filters>
      <div class="filters__head"><b>Filtros</b><button class="link" type="button" data-clear>Quitar filtros</button></div>
      <fieldset class="fgroup"><legend>Para</legend>
        <label class="check"><input type="checkbox" name="para" value="perro" />Perros</label>
        <label class="check"><input type="checkbox" name="para" value="gato" />Gatos</label>
      </fieldset>
      <fieldset class="fgroup"><legend>Tamaño</legend>
        <label class="check"><input type="checkbox" name="talla" value="pequeno" />Pequeño</label>
        <label class="check"><input type="checkbox" name="talla" value="mediano" />Mediano</label>
        <label class="check"><input type="checkbox" name="talla" value="grande" />Grande</label>
      </fieldset>
      <fieldset class="fgroup"><legend>Precio</legend>
        <div class="price-range">
          <input aria-label="Precio mínimo" placeholder="Desde" inputmode="numeric" data-min />
          <input aria-label="Precio máximo" placeholder="Hasta" inputmode="numeric" data-max />
        </div>
      </fieldset>
      <label class="check"><input type="checkbox" data-instock checked />Solo con existencias</label>
    </aside>

    <div class="results">
      <div class="results__bar">
        <span class="results__count" aria-live="polite"><b data-count>…</b> productos<em data-demo hidden> de ejemplo</em></span>
        <div class="results__tools">
          <button class="filter-btn" type="button" aria-expanded="false" aria-controls="filtros" data-filter-toggle><span class="ms" aria-hidden="true">tune</span>Filtros<i data-filter-n hidden></i></button>
          <label class="sort">Ordenar
            <select data-sort>
              <option value="dest">Destacados</option>
              <option value="top">Más vendidos</option>
              <option value="new">Nuevos</option>
              <option value="asc">Menor precio</option>
              <option value="desc">Mayor precio</option>
            </select>
          </label>
        </div>
      </div>

      <!-- las tarjetas se dibujan con el catálogo de Supabase (scripts/catalogo.ts) -->
      <div class="grid" data-grid aria-busy="true">
        {Array.from({ length: 6 }, () => <div class="prod prod--cargando" aria-hidden="true"><span></span><span></span><span></span></div>)}
      </div>
      <div class="empty" data-fail hidden>
        <span class="ms" aria-hidden="true">wifi_off</span>
        <b>No pudimos cargar los productos.</b>
        <p>Revisa tu conexión y vuelve a intentarlo, o escríbenos y te ayudamos con tu pedido.</p>
        <div class="empty__actions"><button class="btn btn--outlined" type="button" onclick="location.reload()">Intentar de nuevo</button><a class="wa-o" href={waShop} target="_blank" rel="noopener"><WaIcon size={22} />Pedir por WhatsApp</a></div>
      </div>

      <div class="empty" data-empty hidden>
        <span class="ms" aria-hidden="true">search</span>
        <b>No encontramos productos con esos filtros.</b>
        <p>Prueba con otra palabra o escríbenos: si no lo tenemos, te lo conseguimos.</p>
        <div class="empty__actions"><button class="btn btn--outlined" type="button" data-clear>Quitar filtros</button><a class="wa-o" href={waShop} target="_blank" rel="noopener"><WaIcon size={22} />Preguntar por WhatsApp</a></div>
      </div>
    </div>

    <!-- mini carrito (escritorio) -->
    <aside class="mini" aria-labelledby="mini-t" data-mini>
      <h2 id="mini-t"><span class="ms" aria-hidden="true">shopping_bag</span>Tu carrito</h2>
      <p class="mini__empty" data-mini-empty>Aún no has agregado productos. Toca <b>+</b> en el que quieras.</p>
      <ul class="mini__list" data-mini-list></ul>
      <div class="mini__total" data-mini-filled hidden><span>Subtotal</span><b data-mini-sub>$0</b></div>
      <div class="mini__ship">
        <span data-ship-text><span class="ms" aria-hidden="true">local_shipping</span> Envío gratis a toda Colombia desde <b>{money(SHIPPING.freeFrom)}</b></span>
        <div class="bar" role="progressbar" aria-label="Avance hacia envío gratis" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-ship-bar><i data-free-fill></i></div>
        <small>En {CIUDADES} el envío siempre es gratis.</small>
      </div>
      <p class="mini__gift" data-gift><span class="ms" aria-hidden="true">redeem</span><span data-gift-text></span></p>
      <div class="mini__extras" data-extras>
        <span>Súmale a tu pedido</span>
        <div data-extras-list></div>
      </div>
      <a class="btn btn--alma mini__go" href="/carrito" data-mini-filled hidden>Ver carrito y pagar<span class="ms" aria-hidden="true">arrow_forward</span></a>
      <a class="wa-o" href={waShop} target="_blank" rel="noopener"><WaIcon size={22} />¿Dudas? Escríbenos</a>
    </aside>
  </section>

  <!-- ======== ASÍ COMPRAS ======== -->
  <section class="wrap buy" aria-labelledby="cc" data-cb="petshop.compras">
    <div class="buy__panel">
      <h2 id="cc" class="h-section" data-ct="petshop.compras.titulo" set:html={TT('petshop.compras.titulo')} />
      <Steps steps={BUY_STEPS} />
    </div>
  </section>

  <WaStrip href={waShop} title={CAMPOS['petshop.wa.titulo'].def} text={CAMPOS['petshop.wa.texto'].def} k="petshop.wa.texto" kt="petshop.wa.titulo" />

  <!-- barra del carrito (celular y tableta) -->
  <div class="dock" data-dock hidden>
    <a class="dock__in" href="/carrito">
      <span class="dock__txt"><b data-dock-sub>$0</b><small data-dock-msg></small></span>
      <span class="dock__go"><span class="dock__bag"><span class="ms" aria-hidden="true">shopping_bag</span><i data-dock-n>0</i></span>Ver carrito</span>
    </a>
  </div>
  <p class="sr-only" aria-live="polite" data-announce></p>

  <SalesBuzz />
</Base>

<script>
  import { cart, progress, money } from '../scripts/cart';
  import { GIFT } from '../data/shop';
  import { catalogo, tarjeta, stockDe, itemCarrito, productoUrl, portada, esc, TONOS, etiquetas, maxDescuento } from '../scripts/catalogo';
  import { supabaseReady } from '../scripts/supabase';
  import '../scripts/add-buttons';

  /* ---------- filtros, búsqueda y orden ---------- */
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  let cards: HTMLElement[] = [];
  const filters = document.querySelector<HTMLElement>('[data-filters]')!;
  const search = document.querySelector<HTMLInputElement>('[data-search]')!;
  const sort = document.querySelector<HTMLSelectElement>('[data-sort]')!;
  const minIn = document.querySelector<HTMLInputElement>('[data-min]')!;
  const maxIn = document.querySelector<HTMLInputElement>('[data-max]')!;
  const inStock = document.querySelector<HTMLInputElement>('[data-instock]')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-cat]')].filter((b) => b.tagName === 'BUTTON');
  const toggle = document.querySelector<HTMLButtonElement>('[data-filter-toggle]')!;
  let cat = '';
  const ESPECIALES = ['dra', 'oferta', 'nuevo'];

  /* ---------- al entrar: categorías; con #categoría en la dirección: sus productos ---------- */
  const home = document.querySelector<HTMLElement>('[data-home]')!;
  const browse = [...document.querySelectorAll<HTMLElement>('[data-browse]')];
  const nombreDe = (id: string) => (id ? chips.find((b) => b.dataset.cat === id)?.textContent ?? 'Todos los productos' : 'Todos los productos');
  const modo = (desplazar = true) => {
    const h = decodeURIComponent(location.hash.slice(1));
    const enCat = !!h && (h === 'todo' || chips.some((b) => b.dataset.cat === h));
    home.hidden = enCat;
    browse.forEach((el) => { el.hidden = !enCat; });
    if (!enCat) return;
    cat = h === 'todo' ? '' : h;
    chips.forEach((x) => { const on = (x.dataset.cat ?? '') === cat; x.classList.toggle('is-on', on); x.setAttribute('aria-pressed', String(on)); });
    document.querySelector('[data-crumb]')!.textContent = nombreDe(cat);
    apply();
    if (desplazar) document.querySelector('[data-browse]')!.scrollIntoView({ block: 'start' });
  };
  window.addEventListener('hashchange', () => modo());
  document.querySelector('[data-home-link]')!.addEventListener('click', (e) => { e.preventDefault(); history.pushState(null, '', location.pathname); modo(); home.scrollIntoView({ block: 'start' }); });

  const num = (s: string) => Number(s.replace(/\D/g, '')) || 0;
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const checkedOf = (name: string) => [...filters.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((i) => i.value);

  const apply = () => {
    const q = norm(search.value.trim());
    const para = checkedOf('para'), talla = checkedOf('talla');
    const min = num(minIn.value), max = num(maxIn.value);
    let shown = 0;
    for (const c of cards) {
      const d = c.dataset;
      const ok = (!cat || (ESPECIALES.includes(cat) ? (d.tags ?? '').split(' ').includes(cat) : d.cat === cat))
        && (!q || norm(d.q!).includes(q))
        && (!para.length || para.some((x) => d.para!.split(' ').includes(x)))
        && (!talla.length || talla.some((x) => d.talla!.split(' ').includes(x)))
        && (!min || Number(d.price) >= min) && (!max || Number(d.price) <= max)
        && (!inStock.checked || Number(d.stock) > 0);
      c.hidden = !ok; if (ok) shown++;
    }
    const by: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      dest: (a, b) => Number(a.dataset.i) - Number(b.dataset.i),
      top: (a, b) => Number(b.dataset.top) - Number(a.dataset.top) || Number(a.dataset.i) - Number(b.dataset.i),
      new: (a, b) => b.dataset.added!.localeCompare(a.dataset.added!),
      asc: (a, b) => Number(a.dataset.price) - Number(b.dataset.price),
      desc: (a, b) => Number(b.dataset.price) - Number(a.dataset.price)
    };
    [...cards].sort(by[sort.value]).forEach((c) => grid.append(c));
    document.querySelector('[data-count]')!.textContent = String(shown);
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = shown > 0 || !cards.length;
    const n = para.length + talla.length + (min ? 1 : 0) + (max ? 1 : 0) + (inStock.checked ? 0 : 1);
    const badge = document.querySelector<HTMLElement>('[data-filter-n]')!;
    badge.textContent = String(n); badge.hidden = n === 0;
  };

  chips.forEach((b) => b.addEventListener('click', () => {
    cat = b.dataset.cat ?? '';
    chips.forEach((x) => { const on = x === b; x.classList.toggle('is-on', on); x.setAttribute('aria-pressed', String(on)); });
    history.replaceState(null, '', '#' + (cat || 'todo'));
    document.querySelector('[data-crumb]')!.textContent = nombreDe(cat);
    apply();
  }));
  search.addEventListener('input', apply);
  sort.addEventListener('change', apply);
  filters.addEventListener('input', apply);
  filters.addEventListener('change', apply);
  document.querySelectorAll('[data-clear]').forEach((b) => b.addEventListener('click', () => {
    filters.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((i) => { i.checked = i === inStock; });
    minIn.value = maxIn.value = ''; search.value = '';
    chips[0].click();
  }));
  toggle.addEventListener('click', () => {
    const open = filters.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
  });

  /* ---------- mini carrito y barra inferior ---------- */
  const mini = document.querySelector<HTMLElement>('[data-mini]')!;
  const dock = document.querySelector<HTMLElement>('[data-dock]')!;
  const paint = () => {
    const items = cart.items();
    const sub = cart.subtotal();
    const p = progress(sub);
    const has = items.length > 0;

    const list = mini.querySelector<HTMLElement>('[data-mini-list]')!;
    list.innerHTML = '';
    for (const it of items) {
      const li = document.createElement('li');
      const ic = document.createElement('span'); ic.className = 'mini__ic'; ic.style.background = it.tone;
      ic.innerHTML = `<span class="ms" aria-hidden="true">${it.icon}</span>`;
      const txt = document.createElement('span'); txt.className = 'mini__txt';
      const name = document.createElement('b'); name.textContent = it.name;
      const meta = document.createElement('span'); meta.textContent = `${it.variant && !/^(único|única)$/i.test(it.variant) ? it.variant + ' · ' : ''}${it.qty} × ${money(it.price)}`;
      txt.append(name, meta);
      const rm = document.createElement('button'); rm.type = 'button'; rm.className = 'mini__rm'; rm.setAttribute('aria-label', `Quitar ${it.name}`);
      rm.innerHTML = '<span class="ms" aria-hidden="true">close</span>';
      rm.addEventListener('click', () => cart.remove(it.key));
      li.append(ic, txt, rm); list.append(li);
    }
    mini.querySelector<HTMLElement>('[data-mini-empty]')!.hidden = has;
    mini.querySelectorAll<HTMLElement>('[data-mini-filled]').forEach((el) => { el.hidden = !has; });
    mini.querySelector('[data-mini-sub]')!.textContent = money(sub);

    const shipText = mini.querySelector<HTMLElement>('[data-ship-text]')!;
    shipText.innerHTML = p.toFree > 0
      ? `<span class="ms" aria-hidden="true">local_shipping</span> Te faltan <b>${money(p.toFree)}</b> para envío gratis a toda Colombia`
      : '<span class="ms" aria-hidden="true">local_shipping</span> <b>¡Tu envío es gratis</b> a toda Colombia!';
    const bar = mini.querySelector<HTMLElement>('[data-ship-bar]')!;
    bar.setAttribute('aria-valuenow', String(p.freePct));
    const fill = bar.querySelector('i')!;
    fill.style.width = p.freePct + '%';
    fill.classList.toggle('is-full', p.freePct >= 100);

    const gift = mini.querySelector<HTMLElement>('[data-gift]')!;
    gift.hidden = !has || !GIFT.active;
    mini.querySelector('[data-gift-text]')!.innerHTML = p.toGift > 0
      ? `Agrega <b>${money(p.toGift)}</b> más y llévate un <b>obsequio</b>`
      : '¡Te ganaste un <b>snack dental</b> de obsequio!';

    // sugerencias: solo las que aún no están en el carrito, máximo 2
    let shown = 0;
    mini.querySelectorAll<HTMLElement>('[data-extra]').forEach((x) => {
      const inCart = items.some((it) => it.id === x.dataset.extra);
      x.hidden = inCart || shown >= 2; if (!x.hidden) shown++;
    });
    mini.querySelector<HTMLElement>('[data-extras]')!.hidden = !has || shown === 0;

    // barra inferior: una sola línea con lo que falta
    dock.hidden = !has;
    document.documentElement.classList.toggle('has-dock', has);
    dock.querySelector('[data-dock-n]')!.textContent = String(cart.count());
    dock.querySelector('[data-dock-sub]')!.textContent = money(sub);
    dock.querySelector('[data-dock-msg]')!.textContent = p.toFree > 0 ? `Envío gratis con ${money(p.toFree)} más` : 'Tu envío es gratis';
  };
  paint();
  cart.onChange(() => {
    paint();
    dock.classList.remove('bump'); void dock.offsetWidth; dock.classList.add('bump');
  });
  /* ---------- catálogo ---------- */
  catalogo().then((lista) => {
    grid.innerHTML = lista.map(tarjeta).join('');
    grid.removeAttribute('aria-busy');
    cards = [...grid.querySelectorAll<HTMLElement>('[data-prod]')];
    document.querySelector<HTMLElement>('[data-demo]')!.hidden = supabaseReady;
    // "Súmale a tu pedido": productos de una sola presentación, los más baratos primero
    const extras = lista.filter((p) => p.variantes.length === 1 && stockDe(p) > 0)
      .sort((a, b) => a.variantes[0].precio - b.variantes[0].precio).slice(0, 6);
    mini.querySelector('[data-extras-list]')!.innerHTML = extras.map((p) => {
      const v = p.variantes[0];
      return `<div class="extra" data-extra="${esc(p.slug)}">
        <span class="extra__ic" style="background:${TONOS[p.tono] ?? TONOS.lav}" aria-hidden="true">${portada(p)}</span>
        <span class="extra__txt"><a href="${productoUrl(p.slug)}">${esc(p.nombre)}</a><span>${money(v.precio)}</span></span>
        <button class="add add--sm" type="button" aria-label="Agregar ${esc(p.nombre)} al carrito" data-add='${esc(JSON.stringify(itemCarrito(p, v)))}'><span class="ms" aria-hidden="true">add</span></button>
      </div>`;
    }).join('');
    paint();
    // categorías al entrar: cuántos productos tiene cada una (según Perros / Gatos)
    let esp = '';
    const pinta = () => {
      document.querySelectorAll<HTMLElement>('[data-tile]').forEach((t) => {
        const id = t.dataset.tile!;
        const n = lista.filter((p) => (!esp || p.para.includes(esp)) && (ESPECIALES.includes(id) ? etiquetas(p).includes(id as never) : p.categoria === id)).length;
        t.querySelector('[data-tile-n]')!.textContent = n ? `${n} ${n === 1 ? 'producto' : 'productos'}` : 'Muy pronto';
        t.hidden = !n && ESPECIALES.includes(id);
      });
      const off = Math.max(0, ...lista.map(maxDescuento));
      const b = document.querySelector<HTMLElement>('[data-off-max]');
      if (b) { b.hidden = !off; b.textContent = `Hasta -${off}%`; }
      const top = lista.filter((p) => (!esp || p.para.includes(esp)) && stockDe(p) > 0);
      const tops = [...top.filter((p) => p.etiquetas.includes('top')), ...top.filter((p) => !p.etiquetas.includes('top'))].slice(0, 4);
      document.querySelector('[data-tops]')!.innerHTML = tops.map(tarjeta).join('');
      document.querySelector<HTMLElement>('[data-tops-wrap]')!.hidden = !tops.length;
    };
    document.querySelectorAll<HTMLButtonElement>('[data-esp]').forEach((b) => b.addEventListener('click', () => {
      esp = b.dataset.esp ?? '';
      document.querySelectorAll<HTMLButtonElement>('[data-esp]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      filters.querySelectorAll<HTMLInputElement>('input[name="para"]').forEach((i) => { i.checked = !!esp && i.value === esp; });
      pinta(); apply();
    }));
    pinta();
    // /petshop#higiene abre la categoría (lo usan las migas de la ficha y las categorías)
    modo(false);
  }).catch(() => {
    grid.hidden = true;
    document.querySelector<HTMLElement>('[data-fail]')!.hidden = false;
    document.querySelector('[data-count]')!.textContent = '0';
  });
</script>

