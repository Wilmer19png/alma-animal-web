---
import { getImage } from 'astro:assets';
import { EQUIPO_BASE, tarjetaPersona } from '../data/equipo';
import albertCuerpo from '../assets/fotos/albert-cuerpo.webp';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WaStrip from '../components/WaStrip.astro';
import { whatsapp, DOCTOR } from '../data/site';
import draCuerpo from '../assets/fotos/dra-cuerpo.webp';

const fotoDra = await getImage({ src: draCuerpo, width: 360, format: 'webp' });
const fotoSpa = await getImage({ src: albertCuerpo, width: 360, format: 'webp' });
const waHola = whatsapp.vet('Hola, Alma Animal. Quiero hacer una pregunta.');
---
<Base
  title="Nosotros · Alma Animal, Pereira"
  description="Conoce a la Dra. Mariana Hoyos Giraldo y al equipo de Alma Animal: consultorio veterinario, spa y petshop en Pereira."
>
  <SiteHeader slot="top" />

  <section class="wrap nos-head" aria-labelledby="nh">
    <a class="back" href="/"><span class="ms" aria-hidden="true">arrow_back</span>Inicio</a>
    <h1 id="nh">Nuestro <b class="gt">equipo</b></h1>
    <p class="lead">Las personas que cuidan a tu mascota en el consultorio, el spa y la tienda. Trabajamos en el mismo lugar, así que nos contamos todo.</p>
  </section>

  <!-- las personas salen del gestor (Equipo); mientras carga, o sin conexión, se ve el equipo de siempre -->
  <section class="wrap nos-team" aria-label="Personas del equipo">
    <div class="team" data-team data-foto-consultorio={fotoDra.src} data-foto-spa={fotoSpa.src}
      set:html={EQUIPO_BASE.map((p, i) => tarjetaPersona(p, { consultorio: fotoDra.src, spa: fotoSpa.src }, i === 0)).join('')} />
  </section>

  <WaStrip href={waHola} text="Escríbenos y te contestamos nosotros mismos, sin bots." />
</Base>

<script>
  import { cargarEquipo, laDoctora, tarjetaPersona } from '../data/equipo';
  const team = document.querySelector<HTMLElement>('[data-team]');
  if (team) cargarEquipo().then((l) => {
    if (!l) return;
    const fotos = { consultorio: team.dataset.fotoConsultorio!, spa: team.dataset.fotoSpa! };
    const dra = laDoctora(l);
    team.innerHTML = l.map((p) => tarjetaPersona(p, fotos, p === dra)).join('');
  });
</script>

<style>
  .nos-head { display: flex; flex-direction: column; gap: 14px; padding-top: 24px; padding-bottom: 32px; }
  .nos-head h1 { font-size: clamp(40px, 8vw, 72px); line-height: 1.02; font-weight: 600; }
  .nos-head .lead { max-width: 56ch; }
  @media (min-width: 900px) { .nos-head { padding-top: 40px; padding-bottom: 48px; } }
  .nos-team { padding-bottom: var(--section); }
</style>
