---
// Landing de un solo producto para los anuncios de Meta: Baño Sanitario para Perros con Pasto.
// La venta se cierra aquí mismo (formulario contraentrega, sin carrito). Producto de Dropi: envío gratis incluido.
// Fotos y videos en public/landing/bano-sanitario/ (sin texto: títulos y precios van en HTML).
import Base from '../layouts/Base.astro';
import Lockup from '../components/Lockup.astro';
import WaIcon from '../components/WaIcon.astro';
import { PHONES, LEGAL, SOCIAL, whatsapp } from '../data/site';
import { DEPARTAMENTOS, money } from '../data/shop';

const P = {
  nombre: 'Baño Sanitario para Perros con Pasto',
  corto: 'Baño Sanitario con Pasto',
  slug: 'bano-sanitario-perros',
  precio: 119900,
  medidas: '70 × 45 cm',
  dropi: '2282266' // interno: no se muestra
};
const R = '/landing/bano-sanitario';
const img = (n: string) => `${R}/img/${n}.webp`;
const vid = (n: string) => ({ src: `${R}/video/${n}.mp4`, poster: `${R}/video/${n}-poster.webp` });
const waPregunta = whatsapp.shop('Hola, quiero información del Baño Sanitario para perros con pasto');
const ig = SOCIAL.instagram[0];
const url = new URL('/bano-sanitario-perros', Astro.site).href;

const galeria = [
  { tipo: 'video', ...vid('agua-pasto-seco'), alt: 'Se echa agua sobre el pasto y queda seco' },
  { tipo: 'img', src: img('producto-cenital-durazno'), alt: 'Baño sanitario visto desde arriba: pasto, rejilla verde y bandeja gris' },
  { tipo: 'img', src: img('boston-terrier-encima'), alt: 'Un boston terrier sentado sobre el baño sanitario' },
  { tipo: 'video', ...vid('perro-va-al-tapete'), alt: 'Un caniche camina hasta el tapete y se sienta' }
] as const;

const para = [
  { t: 'Apartamento sin patio', d: '¿Sin patio? Su patio en tu balcón.', foto: img('balcon-beagle'), alt: 'Un beagle junto al baño sanitario en un balcón' },
  { t: 'Cachorro nuevo', d: 'Un solo lugar para aprender.', foto: img('cachorro-maltes-dormido'), alt: 'Un cachorro maltés dormido junto al tapete' },
  { t: 'Perro mayor', d: 'Para el perrito que ya no alcanza a salir a tiempo.', icono: 'favorite' },
  { t: 'Noches de lluvia', d: 'Sin salir a mojarse a las 11 p. m.', video: vid('perro-va-al-tapete'), alt: 'Un caniche va al tapete dentro de la casa' }
];

const faq = [
  ['¿Cuánto tarda en llegar?', 'De 2 a 5 días hábiles según tu ciudad.'],
  ['¿Tengo que pagar el envío?', 'No, el envío es gratis a toda Colombia.'],
  ['¿Cómo pago?', 'En efectivo cuando el mensajero te lo entregue.'],
  ['¿Le sirve a mi perro?', `Mide ${P.medidas}. Es ideal para perros pequeños y medianos.`],
  ['¿Y si no lo usa al principio?', 'Ponlo donde ya suele ir y llévalo allí después de comer o al despertar. Felicítalo cuando lo use. Cada perro tiene su ritmo.'],
  ['¿Cómo se limpia? ¿Huele?', 'Vacías la bandeja y enjuagas. Recomendamos limpiarlo a diario para que no queden olores.'],
  ['¿Puedo cambiarlo?', 'Escríbenos por WhatsApp si llega con algún defecto.']
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: P.nombre,
  description: 'Tapete sanitario de 3 capas (pasto sintético, rejilla y bandeja), 70 × 45 cm, para perros pequeños y medianos. Lavable y reutilizable.',
  image: [new URL(img('producto-cenital-durazno'), Astro.site).href, new URL(img('hero-pomerania-cenital'), Astro.site).href],
  sku: P.slug,
  brand: { '@type': 'Brand', name: 'Alma Animal' },
  offers: {
    '@type': 'Offer', url, priceCurrency: 'COP', price: P.precio, availability: 'https://schema.org/InStock', itemCondition: 'https://schema.org/NewCondition',
    shippingDetails: { '@type': 'OfferShippingDetails', shippingRate: { '@type': 'MonetaryAmount', value: 0, currency: 'COP' }, shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'CO' } }
  }
};
---
<Base
  title="Baño Sanitario para Perros con Pasto · Envío gratis · Alma Animal"
  description="Tapete sanitario de 3 capas, 70 × 45 cm. El orín baja a la bandeja y el pasto queda seco. Envío gratis a toda Colombia y pagas al recibir."
  waArea="shop"
  image={new URL(img('hero-pomerania-cenital'), Astro.site).href}
  sinWa
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={img('hero-pomerania-cenital')} fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- ======== BARRA SUPERIOR ======== -->
  <div slot="top" class="lp-bar">
    <span><span class="ms" aria-hidden="true">local_shipping</span>Envío <b>GRATIS</b> a toda Colombia</span>
    <span class="lp-bar__dot" aria-hidden="true">·</span>
    <span><span class="ms" aria-hidden="true">payments</span>Pagas al recibir</span>
  </div>

  <div class="lp" data-lp data-precio={P.precio} data-slug={P.slug} data-nombre={P.nombre} data-dropi={P.dropi}
    data-medidas={P.medidas} data-legal={LEGAL.updated} data-shop={PHONES.shop.e164}>

    <!-- ======== PRIMERA PANTALLA ======== -->
    <section class="hero" aria-labelledby="lp-titulo">
      <div class="hero__media">
        <figure class="hero__portada">
          <img src={img('hero-pomerania-cenital')} alt="Un pomerania feliz acostado sobre el baño sanitario de pasto, en la sala" width="880" height="1168" fetchpriority="high" decoding="async" />
          <div class="hero__marca"><Lockup /></div>
          <h1 id="lp-titulo" class="hero__h1">Baño Sanitario <span>para Perros con Pasto</span></h1>
        </figure>

        <div class="gal" data-gal>
          <div class="gal__track" data-gal-track tabindex="0" role="region" aria-roledescription="carrusel" aria-label="Fotos y videos del baño sanitario">
            {galeria.map((g, i) => (
              <div class="gal__slide" role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${galeria.length}`}>
                {g.tipo === 'video'
                  ? <div class="vid"><video muted loop playsinline preload="none" poster={g.poster} aria-label={g.alt} data-vid><source src={g.src} type="video/mp4" /></video><button class="vid__btn" type="button" aria-label="Reproducir video" data-vid-btn hidden><span class="ms" aria-hidden="true">play_arrow</span></button></div>
                  : <img src={g.src} alt={g.alt} width="600" height="600" loading="lazy" decoding="async" />}
              </div>
            ))}
          </div>
          <div class="gal__dots" aria-hidden="true">{galeria.map((_, i) => <span class:list={{ 'is-on': i === 0 }} data-dot />)}</div>
        </div>
      </div>

      <div class="hero__info">
        <p class="hero__sub">Su propio “patio” dentro de casa: el orín baja a la bandeja y el pasto queda seco.</p>
        <div class="precio">
          <b>{money(P.precio)}</b>
          <span class="sello sello--peach"><span class="ms" aria-hidden="true">local_shipping</span>Envío gratis</span>
          <span class="sello sello--lav"><span class="ms" aria-hidden="true">payments</span>Pagas al recibir</span>
        </div>
        <ul class="puntos">
          <li><span class="ms" aria-hidden="true">grass</span><span><b>3 capas:</b> pasto, rejilla y bandeja que recoge el orín</span></li>
          <li><span class="ms" aria-hidden="true">straighten</span><span><b>{P.medidas}</b>, para perros pequeños y medianos</span></li>
          <li><span class="ms" aria-hidden="true">recycling</span><span><b>Lavable y reutilizable</b>, sin desechables</span></li>
        </ul>
        <div class="ctas">
          <a class="cta" href="#pedido" data-pedir>Pedir ahora · Pagas al recibir</a>
          <a class="wa-btn" href={waPregunta} target="_blank" rel="noopener"><WaIcon size={22} class="" />Tengo una pregunta</a>
        </div>
      </div>
    </section>

    <!-- ======== EL PROBLEMA ======== -->
    <section class="wrap blq blq--lav rv" aria-labelledby="lp-problema">
      <div class="split">
        <div class="split__txt">
          <span class="gota" aria-hidden="true"><span class="ms">format_color_reset</span></span>
          <h2 id="lp-problema" class="h2">¿Otra vez charcos en la sala?</h2>
          <p class="txt">Llegas del trabajo y está el charco. Trapeas todos los días y aún huele. No es que tu perro no quiera hacerlo bien: muchas veces no alcanza a salir a tiempo, sobre todo en apartamento, de noche o cuando llueve.</p>
        </div>
        <div class="split__media">
          <div class="vid vid--card"><video muted loop playsinline preload="none" poster={vid('capas-se-levantan').poster} aria-label="Se levantan el pasto y la rejilla y se ve la bandeja con el agua recogida" data-vid><source src={vid('capas-se-levantan').src} type="video/mp4" /></video><button class="vid__btn" type="button" aria-label="Reproducir video" data-vid-btn hidden><span class="ms" aria-hidden="true">play_arrow</span></button></div>
          <p class="cap">El orín queda en la bandeja, no en tu piso.</p>
        </div>
      </div>
    </section>

    <!-- ======== CÓMO FUNCIONA ======== -->
    <section class="wrap blq rv" aria-labelledby="lp-funciona">
      <div class="split">
        <div class="split__media"><img class="foto" src={img('tres-capas-flatlay')} alt="Las tres capas separadas: pasto sintético, rejilla verde y bandeja gris" width="880" height="1168" loading="lazy" decoding="async" /></div>
        <div class="split__txt">
          <h2 id="lp-funciona" class="h2">Así funciona: <b class="gt">3 capas</b></h2>
          <ol class="pasos">
            <li><span class="pasos__n">1</span><span><b>Pasto suave:</b> se siente como afuera y lo reconoce como “su lugar”.</span></li>
            <li><span class="pasos__n">2</span><span><b>Rejilla:</b> deja pasar el líquido y mantiene las patas secas.</span></li>
            <li><span class="pasos__n">3</span><span><b>Bandeja:</b> recoge el orín para que no toque tu piso.</span></li>
          </ol>
        </div>
      </div>
      <div class="duo rv">
        <figure class="duo__item">
          <div class="vid vid--card"><video muted loop playsinline preload="none" poster={vid('armado-3-capas').poster} aria-label="Las tres capas encajan una sobre otra" data-vid><source src={vid('armado-3-capas').src} type="video/mp4" /></video><button class="vid__btn" type="button" aria-label="Reproducir video" data-vid-btn hidden><span class="ms" aria-hidden="true">play_arrow</span></button></div>
          <figcaption>Las 3 capas encajan en segundos.</figcaption>
        </figure>
        <figure class="duo__item">
          <img class="foto foto--sq" src={img('pasto-gotas-macro')} alt="Primer plano del pasto sintético con gotas de agua" width="600" height="600" loading="lazy" decoding="async" />
          <figcaption><b>Patas secas, piso limpio.</b></figcaption>
        </figure>
      </div>

      <!-- medidas: cotas dibujadas con CSS sobre la foto -->
      <div class="medidas rv">
        <figure class="medidas__fig">
          <img src={img('producto-medidas-base')} alt="El baño sanitario visto desde arriba" width="600" height="600" loading="lazy" decoding="async" />
          <span class="cota cota--ancho" aria-hidden="true"><span>70 cm</span></span>
          <span class="cota cota--alto" aria-hidden="true"><span>45 cm</span></span>
        </figure>
        <div class="medidas__txt">
          <h3 class="h3"><span class="ms" aria-hidden="true">straighten</span>Mide 70 × 45 cm</h3>
          <p class="txt">Para perros pequeños y medianos.</p>
        </div>
      </div>
    </section>

    <!-- ======== PARA QUIÉN ES ======== -->
    <section class="blq blq--peach rv" aria-labelledby="lp-para">
      <div class="wrap"><h2 id="lp-para" class="h2">¿Para quién es?</h2></div>
      <ul class="cards" tabindex="0" aria-label="Para quién es: desliza para ver más">
        {para.map((c) => (
          <li class="pcard">
            <div class="pcard__media">
              {c.foto && <img src={c.foto} alt={c.alt} width="600" height="600" loading="lazy" decoding="async" />}
              {c.video && <div class="vid"><video muted loop playsinline preload="none" poster={c.video.poster} aria-label={c.alt} data-vid><source src={c.video.src} type="video/mp4" /></video><button class="vid__btn" type="button" aria-label="Reproducir video" data-vid-btn hidden><span class="ms" aria-hidden="true">play_arrow</span></button></div>}
              {c.icono && <span class="pcard__ic" aria-hidden="true"><span class="ms">{c.icono}</span></span>}
            </div>
            <div class="pcard__txt"><h3>{c.t}</h3><p>{c.d}</p></div>
          </li>
        ))}
      </ul>
    </section>

    <!-- ======== AHORRO ======== -->
    <section class="wrap blq rv" aria-labelledby="lp-ahorro">
      <div class="ahorro">
        <h2 id="lp-ahorro" class="h2">Deja de comprar empapadores cada semana</h2>
        <p class="txt">Los desechables se acaban y se botan. Este se lava y se vuelve a usar.</p>
        <div class="vs">
          <div class="vs__col vs__col--no"><span class="ms" aria-hidden="true">delete</span><b>Empapadores</b><span>Se compran cada semana</span></div>
          <div class="vs__col vs__col--si"><span class="ms" aria-hidden="true">savings</span><b>Baño Sanitario</b><span>Se lava y se reutiliza</span></div>
        </div>
      </div>
    </section>

    <!-- ======== CÓMO SE LIMPIA ======== -->
    <section class="wrap blq blq--lav rv" aria-labelledby="lp-limpia">
      <div class="split split--rev">
        <div class="split__txt">
          <h2 id="lp-limpia" class="h2">Cómo se <b class="gt">limpia</b></h2>
          <ol class="pasos pasos--ic">
            <li><span class="pasos__n"><span class="ms" aria-hidden="true">grid_on</span></span><span>Levantas el pasto con la rejilla.</span></li>
            <li><span class="pasos__n"><span class="ms" aria-hidden="true">inbox</span></span><span>Vacías la bandeja.</span></li>
            <li><span class="pasos__n"><span class="ms" aria-hidden="true">water_drop</span></span><span>Enjuagas y listo.</span></li>
          </ol>
        </div>
        <div class="split__media duo duo--tight">
          <div class="vid vid--card"><video muted loop playsinline preload="none" poster={vid('lavado-facil').poster} aria-label="El tapete se lava en el lavadero" data-vid><source src={vid('lavado-facil').src} type="video/mp4" /></video><button class="vid__btn" type="button" aria-label="Reproducir video" data-vid-btn hidden><span class="ms" aria-hidden="true">play_arrow</span></button></div>
          <img class="foto" src={img('lavado-bandeja')} alt="Se enjuaga la bandeja en el lavadero" width="880" height="1168" loading="lazy" decoding="async" />
        </div>
      </div>
    </section>

    <!-- ======== CÓMO COMPRAS ======== -->
    <section class="wrap blq rv" aria-labelledby="lp-compras">
      <div class="split">
        <div class="split__media"><img class="foto" src={img('entrega-pagas-al-recibir')} alt="Una persona recibe el paquete en la puerta de su casa y paga en efectivo" width="880" height="1168" loading="lazy" decoding="async" /></div>
        <div class="split__txt">
          <h2 id="lp-compras" class="h2">Pides hoy, <b class="gt">pagas cuando te llega</b></h2>
          <ol class="pasos">
            <li><span class="pasos__n">1</span><span>Llenas el formulario (1 minuto).</span></li>
            <li><span class="pasos__n">2</span><span>Te confirmamos por WhatsApp.</span></li>
            <li><span class="pasos__n">3</span><span>Lo recibes en tu casa y pagas en efectivo al mensajero.</span></li>
          </ol>
          <p class="confianza"><span class="ms" aria-hidden="true">verified</span><span><a href="/">Alma Animal</a> · Consultorio, spa y petshop en Pereira · <a href={ig.url} target="_blank" rel="noopener">Instagram {ig.handle}</a></span></p>
        </div>
      </div>
    </section>

    <!-- ======== FORMULARIO DE PEDIDO ======== -->
    <section id="pedido" class="wrap blq pedido" aria-labelledby="lp-pedido" data-pedido>
      <div class="pedido__card">
        <div data-form-wrap>
          <h2 id="lp-pedido" class="h2 pedido__h">Pide el tuyo <span>Envío gratis · Pagas al recibir</span></h2>
          <div class="resumen">
            <img src={img('producto-cenital-durazno')} alt="" width="72" height="72" loading="lazy" decoding="async" />
            <p><b>{P.nombre}</b><span><span data-cant-txt>1 unidad</span> · <b data-total>{money(P.precio)}</b> · Envío gratis</span></p>
          </div>

          <form class="form" novalidate data-form>
            <fieldset class="cant">
              <legend>Cantidad</legend>
              <label><input type="radio" name="cantidad" value="1" checked /><span><b>1 unidad</b>{money(P.precio)}</span></label>
              <label><input type="radio" name="cantidad" value="2" /><span><b>2 unidades</b>{money(P.precio * 2)}</span></label>
            </fieldset>
            <p class="hint">Todos los campos son obligatorios, menos las indicaciones.</p>
            <div class="grid2">
              <div class="fld"><label for="f-nombre">Nombre</label><input id="f-nombre" name="nombre" autocomplete="given-name" placeholder="Ej: Laura" required /><span class="err" id="f-nombre-err">Escribe tu nombre.</span></div>
              <div class="fld"><label for="f-apellido">Apellido</label><input id="f-apellido" name="apellido" autocomplete="family-name" placeholder="Ej: Gómez" required /><span class="err" id="f-apellido-err">Escribe tu apellido.</span></div>
              <div class="fld"><label for="f-celular">Celular</label><input id="f-celular" name="celular" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="Ej: 300 123 4567" required /><span class="hint">Te escribimos a este número por WhatsApp.</span><span class="err" id="f-celular-err">Escribe un celular de 10 dígitos que empiece por 3. Ej: 300 123 4567</span></div>
              <div class="fld"><label for="f-depto">Departamento</label>
                <select id="f-depto" name="departamento" autocomplete="address-level1" required>
                  <option value="">Elige el departamento</option>
                  {DEPARTAMENTOS.map((d) => <option>{d}</option>)}
                </select>
                <span class="err" id="f-depto-err">Elige el departamento.</span>
              </div>
              <div class="fld"><label for="f-ciudad">Ciudad o municipio</label><input id="f-ciudad" name="ciudad" autocomplete="address-level2" placeholder="Ej: Pereira" required /><span class="err" id="f-ciudad-err">Escribe la ciudad o el municipio.</span></div>
              <div class="fld"><label for="f-barrio">Barrio</label><input id="f-barrio" name="barrio" placeholder="Ej: Álamos" required /><span class="err" id="f-barrio-err">Escribe el barrio.</span></div>
              <div class="fld full"><label for="f-direccion">Dirección completa</label><input id="f-direccion" name="direccion" autocomplete="street-address" placeholder="Ej: Calle 19 # 8-34" required /><span class="err" id="f-direccion-err">Escribe la dirección de entrega.</span></div>
              <div class="fld full"><label for="f-indicaciones">Indicaciones (opcional)</label><textarea id="f-indicaciones" name="indicaciones" maxlength="300" placeholder="Torre, apto, punto de referencia"></textarea></div>
            </div>
            <label class="consent"><input type="checkbox" name="datos" required /><span>Acepto los <a href="/terminos" target="_blank">términos</a> y la <a href="/privacidad" target="_blank">política de datos</a> para que me contacten sobre este pedido.</span></label>
            <span class="err" id="f-datos-err">Para enviar tu pedido necesitamos tu autorización.</span>
            <button class="cta cta--full" type="submit" data-enviar><span data-enviar-txt>Confirmar pedido · Pago contraentrega</span></button>
            <p class="err" role="alert" data-fallo hidden>No pudimos guardar el pedido. Te abrimos WhatsApp con el pedido ya escrito para que no se pierda. Si no se abrió, <a href="#" target="_blank" rel="noopener" data-fallo-wa>toca aquí</a>.</p>
          </form>
        </div>

        <div class="gracias" data-gracias hidden>
          <span class="gracias__ic" aria-hidden="true"><span class="ms">check_circle</span></span>
          <h2 class="h2" tabindex="-1" data-gracias-h>¡Pedido recibido!</h2>
          <p class="txt">Te escribimos por WhatsApp para confirmar. Recuerda: <b>pagas al recibir</b>.</p>
          <p class="gracias__cod">Tu código de pedido: <b data-codigo></b></p>
          <a class="wa-btn wa-btn--lg" href="#" target="_blank" rel="noopener" data-gracias-wa><WaIcon size={22} class="" />Confirmar por WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- ======== PREGUNTAS FRECUENTES ======== -->
    <section class="wrap blq faq rv" aria-labelledby="lp-faq">
      <h2 id="lp-faq" class="h2">Preguntas frecuentes</h2>
      <div class="faq__list">
        {faq.map(([q, a]) => (
          <details>
            <summary>{q}<span class="ms" aria-hidden="true">expand_more</span></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
      <a class="wa-btn" href={waPregunta} target="_blank" rel="noopener"><WaIcon size={22} class="" />¿Otra pregunta? Escríbenos</a>
    </section>
  </div>

  <!-- ======== BOTÓN FIJO EN CELULAR ======== -->
  <div class="mbar" data-mbar>
    <a class="cta cta--full" href="#pedido" data-pedir>Pedir ahora · {money(P.precio)}</a>
  </div>
</Base>

<script>
  import { insert, supabaseReady } from '../scripts/supabase';
  import { track } from '../scripts/meta';

  const root = document.querySelector<HTMLElement>('[data-lp]')!;
  const D = root.dataset;
  const PRECIO = Number(D.precio);
  const money = (n: number) => '$' + Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  const wa = (t: string) => `https://wa.me/${D.shop}?text=${encodeURIComponent(t)}`;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const PREVIEW = !supabaseReady && (location.protocol === 'file:' || ['localhost', '127.0.0.1'].includes(location.hostname));

  /* ---------- píxel: vio el producto ---------- */
  const contenido = { content_ids: [D.slug], content_type: 'product', content_name: D.nombre, currency: 'COP' };
  track('ViewContent', { ...contenido, value: PRECIO });
  let checkout = false;
  const iniciar = () => {
    if (checkout) return;
    checkout = true;
    track('InitiateCheckout', { ...contenido, value: PRECIO * cantidad(), num_items: cantidad() });
  };
  document.querySelectorAll('[data-pedir]').forEach((a) => a.addEventListener('click', iniciar));

  /* ---------- datos del anuncio (utm y fbclid) para medir qué campaña vende ---------- */
  const q = new URLSearchParams(location.search);
  const atribucion: Record<string, string> = {};
  for (const k of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid']) {
    const v = q.get(k); if (v) atribucion[k] = v.slice(0, 200);
  }

  /* ---------- videos: en bucle solo mientras se ven; con «reducir movimiento», póster y botón ---------- */
  const videos = [...document.querySelectorAll<HTMLVideoElement>('[data-vid]')];
  if (reduce) {
    videos.forEach((v) => {
      const b = v.parentElement!.querySelector<HTMLButtonElement>('[data-vid-btn]')!;
      b.hidden = false;
      b.addEventListener('click', () => {
        if (v.paused) { v.play().catch(() => {}); b.setAttribute('aria-label', 'Pausar video'); b.querySelector('.ms')!.textContent = 'pause'; }
        else { v.pause(); b.setAttribute('aria-label', 'Reproducir video'); b.querySelector('.ms')!.textContent = 'play_arrow'; }
      });
    });
  } else if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
    }), { threshold: .35 });
    videos.forEach((v) => io.observe(v));
  }

  /* ---------- aparición suave al bajar ---------- */
  const rv = [...document.querySelectorAll<HTMLElement>('.rv')];
  if (!reduce && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js-rv');
    const io = new IntersectionObserver((es, o) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); o.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    rv.forEach((el) => io.observe(el));
  }

  /* ---------- galería deslizable con puntos ---------- */
  const track_ = document.querySelector<HTMLElement>('[data-gal-track]')!;
  const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
  track_.addEventListener('scroll', () => {
    const i = Math.round(track_.scrollLeft / track_.clientWidth);
    dots.forEach((d, j) => d.classList.toggle('is-on', j === i));
  }, { passive: true });

  /* ---------- formulario ---------- */
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const val = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '').trim();
  const cantidad = () => Number((form.querySelector<HTMLInputElement>('[name="cantidad"]:checked'))?.value ?? 1);
  const pintar = () => {
    const n = cantidad();
    document.querySelector('[data-cant-txt]')!.textContent = n === 1 ? '1 unidad' : `${n} unidades`;
    document.querySelector('[data-total]')!.textContent = money(PRECIO * n);
  };
  form.addEventListener('change', pintar);
  form.addEventListener('focusin', iniciar);

  const celular = () => val('celular').replace(/\D/g, '').replace(/^57(?=3\d{9}$)/, '');
  const reglas: [string, () => boolean][] = [
    ['nombre', () => val('nombre').length > 0],
    ['apellido', () => val('apellido').length > 0],
    ['celular', () => /^3\d{9}$/.test(celular())],
    ['depto', () => val('departamento').length > 0],
    ['ciudad', () => val('ciudad').length > 0],
    ['barrio', () => val('barrio').length > 0],
    ['direccion', () => val('direccion').length > 0],
    ['datos', () => (form.elements.namedItem('datos') as HTMLInputElement).checked]
  ];
  const marcar = (k: string, malo: boolean) => {
    const err = document.getElementById(`f-${k}-err`)!;
    err.classList.toggle('is-on', malo);
    const campo = document.getElementById(`f-${k}`) ?? form.querySelector<HTMLElement>(`[name="${k}"]`);
    if (campo) { campo.setAttribute('aria-invalid', String(malo)); if (malo) campo.setAttribute('aria-describedby', err.id); else campo.removeAttribute('aria-describedby'); }
    return campo;
  };
  const validar = () => {
    let primero: HTMLElement | null = null;
    for (const [k, ok] of reglas) { const campo = marcar(k, !ok()); if (!ok() && !primero) primero = campo; }
    primero?.focus();
    return !primero;
  };
  // al corregir un campo con error, el aviso se va
  form.addEventListener('input', (e) => {
    const el = e.target as HTMLElement;
    if (el.getAttribute('aria-invalid') !== 'true') return;
    const r = reglas.find(([k]) => `f-${k}` === el.id || (el as HTMLInputElement).name === k);
    if (r && r[1]()) marcar(r[0], false);
  });

  let enviando = false;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (enviando || !validar()) return;
    const n = cantidad();
    const total = PRECIO * n;
    const codigo = 'AA-' + Date.now().toString(36).slice(-5).toUpperCase();
    const datos = { nombre: val('nombre'), apellido: val('apellido'), celular: celular(), departamento: val('departamento'), ciudad: val('ciudad'), direccion: val('direccion'), barrio: val('barrio'), indicaciones: val('indicaciones') };
    const fila = {
      codigo, ...datos, correo: null, indicaciones: datos.indicaciones || null,
      items: [{ id: D.slug, nombre: D.nombre, variante: D.medidas, precio: PRECIO, cantidad: n, proveedor: 'dropi', dropi_id: D.dropi }],
      subtotal: total, envio: 0, prioritario: false, total, obsequio: false, aviso_compras: false,
      acepto_terminos: true, version_politicas: D.legal
    };
    const msg = [
      `Hola, Alma Animal. Quiero confirmar mi pedido ${codigo}:`,
      `• ${n} × ${D.nombre} — ${money(total)}`,
      'Envío gratis · Pago contraentrega', '',
      `Para: ${datos.nombre} ${datos.apellido} · ${datos.celular}`,
      `Dirección: ${datos.direccion}, barrio ${datos.barrio}, ${datos.ciudad} (${datos.departamento})`,
      datos.indicaciones ? `Indicaciones: ${datos.indicaciones}` : ''
    ].filter(Boolean).join('\n');

    enviando = true;
    const btn = form.querySelector<HTMLButtonElement>('[data-enviar]')!;
    btn.disabled = true;
    form.querySelector('[data-enviar-txt]')!.textContent = 'Enviando tu pedido…';
    form.querySelector<HTMLElement>('[data-fallo]')!.hidden = true;

    // con los datos del anuncio; si la base aún no tiene esas columnas, se guarda sin ellas
    let res = PREVIEW ? 'ok' : await insert('pedidos', { ...fila, fuente: 'landing-meta', modo_envio: 'gratis', atribucion: Object.keys(atribucion).length ? atribucion : null });
    if (res === 'error') res = await insert('pedidos', fila);

    enviando = false;
    btn.disabled = false;
    form.querySelector('[data-enviar-txt]')!.textContent = 'Confirmar pedido · Pago contraentrega';

    if (res === 'ok') {
      track('Purchase', { ...contenido, value: total, num_items: n, order_id: codigo, contents: [{ id: D.slug, quantity: n, item_price: PRECIO }] },
        { celular: datos.celular, nombre: datos.nombre, apellido: datos.apellido, ciudad: datos.ciudad, departamento: datos.departamento }, codigo);
      document.querySelector<HTMLElement>('[data-form-wrap]')!.hidden = true;
      const g = document.querySelector<HTMLElement>('[data-gracias]')!;
      g.hidden = false;
      g.querySelector('[data-codigo]')!.textContent = codigo;
      g.querySelector<HTMLAnchorElement>('[data-gracias-wa]')!.href = wa(msg);
      document.querySelector<HTMLElement>('[data-mbar]')!.hidden = true;
      document.getElementById('pedido')!.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      g.querySelector<HTMLElement>('[data-gracias-h]')!.focus({ preventScroll: true });
    } else {
      // no se pierde la venta: el pedido sale por WhatsApp
      const href = wa(`Hola, Alma Animal. Quiero hacer este pedido (${codigo}):\n` + msg.split('\n').slice(1).join('\n'));
      const f = form.querySelector<HTMLElement>('[data-fallo]')!;
      f.querySelector<HTMLAnchorElement>('[data-fallo-wa]')!.href = href;
      f.hidden = false;
      window.open(href, '_blank', 'noopener') ?? (location.href = href);
    }
  });

  /* ---------- barra fija: se oculta cuando el formulario está en pantalla ---------- */
  const mbar = document.querySelector<HTMLElement>('[data-mbar]')!;
  const hero = document.querySelector<HTMLElement>('.ctas')!;
  // también mientras se ven los botones de la primera pantalla (no repetir el mismo botón dos veces)
  const visibles = new Set<Element>();
  const obs = new IntersectionObserver((es) => {
    es.forEach((e) => (e.isIntersecting ? visibles.add(e.target) : visibles.delete(e.target)));
    mbar.classList.toggle('is-off', visibles.size > 0);
  });
  obs.observe(document.getElementById('pedido')!);
  obs.observe(hero);
</script>

<style>
