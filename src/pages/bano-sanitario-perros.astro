  .fld label { font: 600 15px/1.3 var(--font-sans); }
  .fld input, .fld select, .fld textarea { width: 100%; min-height: 52px; border-radius: 12px; border: 1px solid #7A7580; background: #fff; padding: 0 16px; font: 400 17px/1.3 var(--font-sans); color: var(--ink); outline: 0; transition: border-color .15s, box-shadow .15s; }
