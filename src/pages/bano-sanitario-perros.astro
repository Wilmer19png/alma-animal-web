---
// Landing de un solo producto para los anuncios de Meta: Baño Sanitario para Perros con Pasto.
// «Pedir ahora» abre el checkout por pasos en una ventana flotante (sin salir de la página); el mismo checkout está
// al final de la página. «Agregar al carrito» lo deja en el carrito de siempre.
// Producto de Dropi: envío gratis incluido. Reseñas con estrellas y foto (supabase/28, se publican tras revisarlas).
// Fotos y videos en public/landing/bano-sanitario/ (sin texto: títulos y precios van en HTML).
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WaIcon from '../components/WaIcon.astro';
import PedirCta from '../components/PedirCta.astro';
import CheckoutLanding from '../components/CheckoutLanding.astro';
import { PHONES, LEGAL, SOCIAL, whatsapp } from '../data/site';
import { money } from '../data/shop';

const P = {
  nombre: 'Baño Sanitario para Perros con Pasto',
  corto: 'Baño Sanitario con Pasto',
  slug: 'bano-sanitario-perros',
  precio: 119900,
  antes: 135900, // precio anterior real (sale tachado)
  medidas: '70 × 45 cm',
  dropi: '2282266' // interno: no se muestra
};
// Promoción con fecha de fin REAL (ej. '2026-11-30T23:59:00-05:00'). Con null no sale el letrero.
// El precio tachado sale solo si en el gestor la variante tiene «precio antes» (un precio que de verdad se cobró).
const PROMO: { hasta: string | null; texto: string } = { hasta: null, texto: 'Envío gratis a toda Colombia' };
const R = '/landing/bano-sanitario';
const img = (n: string) => `${R}/img/${n}.webp`;
const vid = (n: string) => ({ src: `${R}/video/${n}.mp4`, poster: `${R}/video/${n}-poster.webp` });
const waPregunta = whatsapp.shop('Hola, quiero información del Baño Sanitario para perros con pasto');
const ig = SOCIAL.instagram[0];
const url = new URL('/bano-sanitario-perros', Astro.site).href;

const galeria = [
  { tipo: 'video', ...vid('agua-pasto-seco'), alt: 'Se echa agua sobre el pasto y queda seco' },
  { tipo: 'img', src: img('producto-cenital-durazno'), alt: 'Baño sanitario visto desde arriba: pasto, rejilla verde y bandeja gris' },
  { tipo: 'img', src: img('boston-terrier-encima'), alt: 'Un boston terrier sentado sobre el baño sanitario' },
  { tipo: 'video', ...vid('perro-va-al-tapete'), alt: 'Un caniche camina hasta el tapete y se sienta' }
] as const;

const para = [
  { t: 'Apartamento sin patio', d: '¿Sin patio? Su patio en tu balcón.', foto: img('balcon-beagle'), alt: 'Un beagle junto al baño sanitario en un balcón' },
  { t: 'Cachorro nuevo', d: 'Un solo lugar para aprender.', foto: img('cachorro-maltes-dormido'), alt: 'Un cachorro maltés dormido junto al tapete' },
  { t: 'Perro mayor', d: 'Para el perrito que ya no alcanza a salir a tiempo.', icono: 'favorite' },
  { t: 'Noches de lluvia', d: 'Sin salir a mojarse a las 11 p. m.', video: vid('perro-va-al-tapete'), alt: 'Un caniche va al tapete dentro de la casa' }
];

const faq = [
  ['¿Cuánto tarda en llegar?', 'De 2 a 5 días hábiles según tu ciudad.'],
  ['¿Tengo que pagar el envío?', 'No, el envío es gratis a toda Colombia.'],
  ['¿Cómo pago?', 'En efectivo cuando el mensajero te lo entregue.'],
  ['¿Le sirve a mi perro?', `Mide ${P.medidas}. Es ideal para perros pequeños y medianos.`],
  ['¿Y si no lo usa al principio?', 'Ponlo donde ya suele ir y llévalo allí después de comer o al despertar. Felicítalo cuando lo use. Cada perro tiene su ritmo.'],
  ['¿Cómo se limpia? ¿Huele?', 'Vacías la bandeja y enjuagas. Recomendamos limpiarlo a diario para que no queden olores.'],
  ['¿Puedo cambiarlo?', 'Escríbenos por WhatsApp si llega con algún defecto.']
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: P.nombre,
  description: 'Tapete sanitario de 3 capas (pasto sintético, rejilla y bandeja), 70 × 45 cm, para perros pequeños y medianos. Lavable y reutilizable.',
  image: [new URL(img('producto-cenital-durazno'), Astro.site).href, new URL(img('hero-pomerania-cenital'), Astro.site).href],
  sku: P.slug,
  brand: { '@type': 'Brand', name: 'Alma Animal' },
  offers: {
    '@type': 'Offer', url, priceCurrency: 'COP', price: P.precio, availability: 'https://schema.org/InStock', itemCondition: 'https://schema.org/NewCondition',
    shippingDetails: { '@type': 'OfferShippingDetails', shippingRate: { '@type': 'MonetaryAmount', value: 0, currency: 'COP' }, shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'CO' } }
  }
};
---
<Base
  title="Baño Sanitario para Perros con Pasto · Envío gratis · Alma Animal"
  description="Tapete sanitario de 3 capas, 70 × 45 cm. El orín baja a la bandeja y el pasto queda seco. Envío gratis a toda Colombia y pagas al recibir."
  waArea="shop"
  image={new URL(img('hero-pomerania-cenital'), Astro.site).href}
  sinWa
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={img('hero-pomerania-cenital')} fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- ======== BARRA DE ENVÍO + MENÚ DEL SITIO ======== -->
  <div slot="top" class="lp-bar">
    <span><span class="ms" aria-hidden="true">local_shipping</span>Envío <b>GRATIS</b> a toda Colombia</span>
    <span class="lp-bar__dot" aria-hidden="true">·</span>
    <span><span class="ms" aria-hidden="true">payments</span>Pagas al recibir</span>
  </div>
  <SiteHeader slot="top" />

  <div class="lp" data-lp data-precio={P.precio} data-slug={P.slug} data-nombre={P.nombre} data-dropi={P.dropi}
    data-medidas={P.medidas} data-legal={LEGAL.updated} data-shop={PHONES.shop.e164}>

    <nav class="wrap crumbs" aria-label="Estás en">
      <a href="/petshop">Petshop</a><span class="ms" aria-hidden="true">chevron_right</span>
      <a href="/petshop#higiene">Higiene</a><span class="ms" aria-hidden="true">chevron_right</span>
      <span aria-current="page">{P.corto}</span>
    </nav>

    <!-- ======== PRIMERA PANTALLA ======== -->
    <section class="hero" aria-labelledby="lp-titulo">
      <div class="hero__media">
        <figure class="hero__portada">
          <img src={img('hero-pomerania-cenital')} alt="Un pomerania feliz acostado sobre el baño sanitario de pasto, en la sala" width="880" height="1168" fetchpriority="high" decoding="async" />
          <h1 id="lp-titulo" class="hero__h1">Baño Sanitario <span>para Perros con Pasto</span></h1>
        </figure>

        <div class="gal" data-gal>
          <div class="gal__track" data-gal-track tabindex="0" role="region" aria-roledescription="carrusel" aria-label="Fotos y videos del baño sanitario">
            {galeria.map((g, i) => (
              <div class="gal__slide" role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${galeria.length}`}>
                {g.tipo === 'video'
                  ? <div class="vid"><video muted loop playsinline preload="none" poster={g.poster} aria-label={g.alt} data-vid><source src={g.src} type="video/mp4" /></video><button class="vid__btn" type="button" aria-label="Reproducir video" data-vid-btn hidden><span class="ms" aria-hidden="true">play_arrow</span></button></div>
                  : <img src={g.src} alt={g.alt} width="600" height="600" loading="lazy" decoding="async" />}
              </div>
            ))}
          </div>
          <div class="gal__dots" aria-hidden="true">{galeria.map((_, i) => <span class:list={{ 'is-on': i === 0 }} data-dot />)}</div>
        </div>
      </div>

      <div class="hero__info">
        <a class="hero__stars" href="#opiniones" data-hero-stars><span class="stars" aria-hidden="true">☆☆☆☆☆</span><span data-hero-stars-txt>Sé el primero en opinar</span></a>
        <p class="hero__sub">Su propio “patio” dentro de casa: el orín baja a la bandeja y el pasto queda seco.</p>
        <div class="precio">
          {P.antes > P.precio && <s class="antes" data-antes aria-label={`Antes ${money(P.antes)}`}>{money(P.antes)}</s>}
          <b>{money(P.precio)}</b>
          {P.antes > P.precio && <span class="off" data-off>-{Math.round((1 - P.precio / P.antes) * 100)}%</span>}
          <span class="sello sello--peach"><span class="ms" aria-hidden="true">local_shipping</span>Envío gratis</span>
          <span class="sello sello--lav"><span class="ms" aria-hidden="true">payments</span>Pagas al recibir</span>
        </div>
        <ul class="puntos">
          <li><span class="ms" aria-hidden="true">grass</span><span><b>3 capas:</b> pasto, rejilla y bandeja que recoge el orín</span></li>
          <li><span class="ms" aria-hidden="true">straighten</span><span><b>{P.medidas}</b>, para perros pequeños y medianos</span></li>
          <li><span class="ms" aria-hidden="true">recycling</span><span><b>Lavable y reutilizable</b>, sin desechables</span></li>
        </ul>
        {PROMO.hasta && <p class="promo" data-promo={PROMO.hasta} hidden><span class="ms" aria-hidden="true">timer</span><span>{PROMO.texto} · termina en <b data-promo-t></b></span></p>}
        <div class="ctas" data-ctas-hero><PedirCta nota={false} /></div>
      </div>
    </section>

    <!-- ======== EL PROBLEMA ======== -->
    <section class="wrap blq blq--lav rv" aria-labelledby="lp-problema">
      <div class="split">
        <div class="split__txt">
          <span class="gota" aria-hidden="true"><span class="ms">format_color_reset</span></span>
          <h2 id="lp-problema" class="h2">¿Otra vez charcos en la sala?</h2>
          <p class="txt">Llegas del trabajo y está el charco. Trapeas todos los días y aún huele. No es que tu perro no quiera hacerlo bien: muchas veces no alcanza a salir a tiempo, sobre todo en apartamento, de noche o cuando llueve.</p>
          <p class="txt"><b>Con el Baño Sanitario tiene su lugar dentro de casa.</b></p>
          <PedirCta />
        </div>
        <div class="split__media">
          <div class="vid vid--card"><video muted loop playsinline preload="none" poster={vid('capas-se-levantan').poster} aria-label="Se levantan el pasto y la rejilla y se ve la bandeja con el agua recogida" data-vid><source src={vid('capas-se-levantan').src} type="video/mp4" /></video><button class="vid__btn" type="button" aria-label="Reproducir video" data-vid-btn hidden><span class="ms" aria-hidden="true">play_arrow</span></button></div>
          <p class="cap">El orín queda en la bandeja, no en tu piso.</p>
        </div>
      </div>
    </section>

    <!-- ======== CÓMO FUNCIONA ======== -->
    <section class="wrap blq rv" aria-labelledby="lp-funciona">
      <div class="split">
        <div class="split__media"><img class="foto" src={img('tres-capas-flatlay')} alt="Las tres capas separadas: pasto sintético, rejilla verde y bandeja gris" width="880" height="1168" loading="lazy" decoding="async" /></div>
        <div class="split__txt">
          <h2 id="lp-funciona" class="h2">Así funciona: <b class="gt">3 capas</b></h2>
          <ol class="pasos">
            <li><span class="pasos__n">1</span><span><b>Pasto suave:</b> se siente como afuera y lo reconoce como “su lugar”.</span></li>
            <li><span class="pasos__n">2</span><span><b>Rejilla:</b> deja pasar el líquido y mantiene las patas secas.</span></li>
            <li><span class="pasos__n">3</span><span><b>Bandeja:</b> recoge el orín para que no toque tu piso.</span></li>
          </ol>
        </div>
      </div>
      <div class="duo rv">
        <figure class="duo__item">
          <div class="vid vid--card"><video muted loop playsinline preload="none" poster={vid('armado-3-capas').poster} aria-label="Las tres capas encajan una sobre otra" data-vid><source src={vid('armado-3-capas').src} type="video/mp4" /></video><button class="vid__btn" type="button" aria-label="Reproducir video" data-vid-btn hidden><span class="ms" aria-hidden="true">play_arrow</span></button></div>
          <figcaption>Las 3 capas encajan en segundos.</figcaption>
        </figure>
        <figure class="duo__item">
          <img class="foto foto--sq" src={img('pasto-gotas-macro')} alt="Primer plano del pasto sintético con gotas de agua" width="600" height="600" loading="lazy" decoding="async" />
          <figcaption><b>Patas secas, piso limpio.</b></figcaption>
        </figure>
      </div>

      <!-- medidas: cotas dibujadas con CSS sobre la foto -->
      <div class="medidas rv">
        <figure class="medidas__fig">
          <img src={img('producto-medidas-base')} alt="El baño sanitario visto desde arriba" width="600" height="600" loading="lazy" decoding="async" />
          <span class="cota cota--ancho" aria-hidden="true"><span>70 cm</span></span>
          <span class="cota cota--alto" aria-hidden="true"><span>45 cm</span></span>
        </figure>
        <div class="medidas__txt">
          <h3 class="h3"><span class="ms" aria-hidden="true">straighten</span>Mide 70 × 45 cm</h3>
          <p class="txt">Para perros pequeños y medianos.</p>
          <PedirCta nota={false} />
        </div>
      </div>
    </section>

    <!-- ======== PARA QUIÉN ES ======== -->
    <section class="blq blq--peach rv" aria-labelledby="lp-para">
      <div class="wrap"><h2 id="lp-para" class="h2">¿Para quién es?</h2></div>
      <ul class="cards" tabindex="0" aria-label="Para quién es: desliza para ver más">
        {para.map((c) => (
          <li class="pcard">
            <div class="pcard__media">
              {c.foto && <img src={c.foto} alt={c.alt} width="600" height="600" loading="lazy" decoding="async" />}
              {c.video && <div class="vid"><video muted loop playsinline preload="none" poster={c.video.poster} aria-label={c.alt} data-vid><source src={c.video.src} type="video/mp4" /></video><button class="vid__btn" type="button" aria-label="Reproducir video" data-vid-btn hidden><span class="ms" aria-hidden="true">play_arrow</span></button></div>}
              {c.icono && <span class="pcard__ic" aria-hidden="true"><span class="ms">{c.icono}</span></span>}
            </div>
            <div class="pcard__txt"><h3>{c.t}</h3><p>{c.d}</p></div>
          </li>
        ))}
      </ul>
      <div class="wrap"><PedirCta centro /></div>
    </section>

    <!-- ======== AHORRO ======== -->
    <section class="wrap blq rv" aria-labelledby="lp-ahorro">
      <div class="ahorro">
        <h2 id="lp-ahorro" class="h2">Deja de comprar empapadores cada semana</h2>
        <p class="txt">Los desechables se acaban y se botan. Este se lava y se vuelve a usar.</p>
        <div class="vs">
          <div class="vs__col vs__col--no"><span class="ms" aria-hidden="true">delete</span><b>Empapadores</b><span>Se compran cada semana</span></div>
          <div class="vs__col vs__col--si"><span class="ms" aria-hidden="true">savings</span><b>Baño Sanitario</b><span>Se lava y se reutiliza</span></div>
        </div>
        <PedirCta />
      </div>
    </section>

    <!-- ======== CÓMO SE LIMPIA ======== -->
    <section class="wrap blq blq--lav rv" aria-labelledby="lp-limpia">
      <div class="split split--rev">
        <div class="split__txt">
          <h2 id="lp-limpia" class="h2">Cómo se <b class="gt">limpia</b></h2>
          <ol class="pasos pasos--ic">
            <li><span class="pasos__n"><span class="ms" aria-hidden="true">grid_on</span></span><span>Levantas el pasto con la rejilla.</span></li>
            <li><span class="pasos__n"><span class="ms" aria-hidden="true">inbox</span></span><span>Vacías la bandeja.</span></li>
            <li><span class="pasos__n"><span class="ms" aria-hidden="true">water_drop</span></span><span>Enjuagas y listo.</span></li>
          </ol>
          <PedirCta nota={false} />
        </div>
        <div class="split__media duo duo--tight">
          <div class="vid vid--card"><video muted loop playsinline preload="none" poster={vid('lavado-facil').poster} aria-label="El tapete se lava en el lavadero" data-vid><source src={vid('lavado-facil').src} type="video/mp4" /></video><button class="vid__btn" type="button" aria-label="Reproducir video" data-vid-btn hidden><span class="ms" aria-hidden="true">play_arrow</span></button></div>
          <img class="foto" src={img('lavado-bandeja')} alt="Se enjuaga la bandeja en el lavadero" width="880" height="1168" loading="lazy" decoding="async" />
        </div>
      </div>
    </section>

    <!-- ======== CÓMO COMPRAS ======== -->
    <section class="wrap blq rv" aria-labelledby="lp-compras">
      <div class="split">
        <div class="split__media"><img class="foto" src={img('entrega-pagas-al-recibir')} alt="Una persona recibe el paquete en la puerta de su casa y paga en efectivo" width="880" height="1168" loading="lazy" decoding="async" /></div>
        <div class="split__txt">
          <h2 id="lp-compras" class="h2">Pides hoy, <b class="gt">pagas cuando te llega</b></h2>
          <ol class="pasos">
            <li><span class="pasos__n">1</span><span>Lo pides aquí y llenas tus datos de envío (1 minuto).</span></li>
            <li><span class="pasos__n">2</span><span>Te confirmamos por WhatsApp.</span></li>
            <li><span class="pasos__n">3</span><span>Lo recibes en tu casa y pagas en efectivo al mensajero.</span></li>
          </ol>
          <p class="confianza"><span class="ms" aria-hidden="true">verified</span><span><a href="/">Alma Animal</a> · Consultorio, spa y petshop en Pereira · <a href={ig.url} target="_blank" rel="noopener">Instagram {ig.handle}</a></span></p>
        </div>
      </div>
    </section>

    <!-- ======== RESEÑAS ======== -->
    <section id="opiniones" class="wrap blq resenas rv" aria-labelledby="lp-resenas" data-resenas>
      <div class="resenas__head">
        <h2 id="lp-resenas" class="h2">Opiniones</h2>
        <p class="resenas__prom" data-promedio hidden></p>
      </div>
      <ul class="resenas__lista" data-lista></ul>
      <p class="txt" data-vacio>Aún no hay opiniones de este producto. Si ya lo tienes, cuéntanos cómo te ha ido.</p>

      <details class="opinar" data-opinar>
        <summary><span class="ms" aria-hidden="true">rate_review</span>Deja tu opinión</summary>
        <form class="form" novalidate data-form-resena>
          <fieldset class="estrellas">
            <legend>¿Cuántas estrellas le das? <span class="req">*</span></legend>
            <div class="estrellas__fila">
              {[5, 4, 3, 2, 1].map((n) => <Fragment><input type="radio" name="estrellas" id={`r-e${n}`} value={n} /><label for={`r-e${n}`} title={`${n} de 5`}><span class="ms" aria-hidden="true">star</span><span class="sr-only">{n} de 5 estrellas</span></label></Fragment>)}
            </div>
            <span class="err" id="r-estrellas-err">Elige de 1 a 5 estrellas.</span>
          </fieldset>
          <div class="grid2">
            <div class="fld"><label for="r-nombre">Tu nombre <span class="req">*</span></label><input id="r-nombre" name="nombre" maxlength="60" autocomplete="given-name" placeholder="Ej: Laura G." required /><span class="err" id="r-nombre-err">Escribe tu nombre.</span></div>
            <div class="fld"><label for="r-ciudad">Ciudad (opcional)</label><input id="r-ciudad" name="ciudad" maxlength="60" autocomplete="address-level2" placeholder="Ej: Pereira" /></div>
            <div class="fld full"><label for="r-comentario">Tu comentario <span class="req">*</span></label><textarea id="r-comentario" name="comentario" maxlength="1000" placeholder="¿Cómo le ha ido a tu perro con el baño sanitario?" required></textarea><span class="err" id="r-comentario-err">Escribe tu comentario (mínimo 3 letras).</span></div>
            <div class="fld full">
              <span class="fld__lbl">Foto (opcional)</span>
              <label class="foto-in" for="r-foto"><span class="ms" aria-hidden="true">add_a_photo</span><span data-foto-txt>Agregar una foto</span></label>
              <input id="r-foto" name="foto" type="file" accept="image/*" class="sr-only" />
              <img class="foto-prev" alt="Vista previa de tu foto" data-foto-prev hidden />
              <span class="err" id="r-foto-err">No pudimos usar esa foto. Prueba con otra (JPG o PNG).</span>
            </div>
          </div>
          <label class="consent"><input type="checkbox" name="datos" id="r-datos" required /><span>Autorizo publicar mi nombre, ciudad, comentario y foto en esta página, según la <a href="/privacidad" target="_blank">política de datos</a>.</span></label>
          <span class="err" id="r-datos-err">Para publicar tu opinión necesitamos tu autorización.</span>
          <button class="enviar-resena" type="submit" data-enviar-resena>Enviar opinión</button>
          <p class="err" role="alert" data-resena-fallo hidden>No pudimos enviar tu opinión. Revisa tu conexión e inténtalo de nuevo.</p>
        </form>
        <div class="gracias" data-resena-ok hidden>
          <span class="gracias__ic" aria-hidden="true"><span class="ms">check_circle</span></span>
          <p class="h3" tabindex="-1" data-resena-ok-h>¡Gracias por tu opinión!</p>
          <p class="txt">La revisamos y la publicamos pronto.</p>
        </div>
      </details>
    </section>

    <!-- ======== PREGUNTAS FRECUENTES ======== -->
    <section class="wrap blq faq rv" aria-labelledby="lp-faq">
      <h2 id="lp-faq" class="h2">Preguntas frecuentes</h2>
      <div class="faq__list">
        {faq.map(([q, a]) => (
          <details>
            <summary>{q}<span class="ms" aria-hidden="true">expand_more</span></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
      <a class="wa-btn" href={waPregunta} target="_blank" rel="noopener"><WaIcon size={22} class="" />¿Otra pregunta? Escríbenos</a>
    </section>

    <!-- ======== CHECKOUT AL FINAL DE LA PÁGINA ======== -->
    <section id="pedido" class="wrap blq pedido" aria-labelledby="f-t">
      <div class="pedido__card">
        <CheckoutLanding pre="f" titulo slug={P.slug} nombre={P.nombre} precio={P.precio} variante={P.medidas} foto={img('producto-cenital-durazno')} dropi={P.dropi} legal={LEGAL.updated} shop={PHONES.shop.e164} />
      </div>
    </section>
  </div>

  <!-- ======== VENTANA FLOTANTE DE PEDIDO ======== -->
  <dialog class="ckd" data-ck-dialog aria-labelledby="ckd-t">
    <div class="ckd__in">
      <div class="ckd__head">
        <p class="ckd__t" id="ckd-t">Pide tu Baño Sanitario</p>
        <button type="button" class="ckd__x" data-ck-cerrar aria-label="Cerrar"><span class="ms" aria-hidden="true">close</span></button>
      </div>
      <CheckoutLanding pre="m" slug={P.slug} nombre={P.nombre} precio={P.precio} variante={P.medidas} foto={img('producto-cenital-durazno')} dropi={P.dropi} legal={LEGAL.updated} shop={PHONES.shop.e164} />
    </div>
  </dialog>

  <!-- ======== BOTÓN FIJO EN CELULAR ======== -->
  <div class="mbar" data-mbar>
    <button class="cta cta--full" type="button" data-pedir><span class="ms" aria-hidden="true">shopping_bag</span>Pedir ahora</button>
  </div>
</Base>

<script>
  import { cart } from '../scripts/cart';
  import { avisarAgregado } from '../scripts/add-buttons';
  import { productoPorSlug, itemCarrito, esc, TONOS } from '../scripts/catalogo';
  import { insert, supabaseReady } from '../scripts/supabase';
  import { track } from '../scripts/meta';

  const root = document.querySelector<HTMLElement>('[data-lp]')!;
  const D = root.dataset;
  const PRECIO = Number(D.precio);
  const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
  const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const enArchivo = location.protocol === 'file:';

  /* ---------- píxel: vio el producto (AddToCart, InitiateCheckout y Purchase salen del carrito de siempre) ---------- */
  track('ViewContent', { content_ids: [D.slug], content_type: 'product', content_name: D.nombre, value: PRECIO, currency: 'COP' });

  /* ---------- de dónde viene (anuncio): el carrito lo guarda con el pedido ---------- */
  const q = new URLSearchParams(location.search);
  const atribucion: Record<string, string> = {};
  for (const k of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid']) {
    const v = q.get(k); if (v) atribucion[k] = v.slice(0, 200);
  }
  try {
    const hay = Object.keys(atribucion).length > 0;
    if (hay || !sessionStorage.getItem('alma-origen')) {
      sessionStorage.setItem('alma-origen', JSON.stringify({ fuente: hay ? 'landing-meta' : 'landing', modo_envio: 'gratis', atribucion: hay ? atribucion : null }));
    }
  } catch { /* sin almacenamiento */ }

  /* ---------- comprar: el producto del catálogo (con su variante, para el inventario) ---------- */
  let item = { id: D.slug!, name: D.nombre!, variant: D.medidas!, price: PRECIO, icon: 'grass', tone: TONOS.peach, max: 10 } as Parameters<typeof cart.add>[0];
  productoPorSlug(D.slug!).then((p) => {
    const v = p?.variantes[0];
    // Dropi maneja el inventario: si en la tienda figura en cero, igual se puede pedir
    if (p && v) item = { ...itemCarrito(p, v), max: Math.max(v.stock, 10) };
    // precio tachado: solo si en el gestor tiene un «precio antes» mayor (promoción real)
    if (v?.antes && v.antes > v.precio) {
      const s = document.querySelector<HTMLElement>('[data-antes]'), off = document.querySelector<HTMLElement>('[data-off]');
      if (!s || !off) return;
      s.textContent = '$' + v.antes.toLocaleString('es-CO'); s.setAttribute('aria-label', 'Antes ' + s.textContent); s.hidden = false;
      off.textContent = '-' + Math.round((1 - v.precio / v.antes) * 100) + '%'; off.hidden = false;
    }
  }).catch(() => { /* queda el producto base */ });

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const agregar = t.closest<HTMLButtonElement>('[data-agregar]');
    if (agregar) {
      cart.add(item);
      avisarAgregado(item);
      agregar.classList.add('is-added');
      const ic = agregar.querySelector('.ms')!;
      ic.textContent = 'check';
      window.setTimeout(() => { agregar.classList.remove('is-added'); ic.textContent = 'add_shopping_cart'; }, 1400);
    }
  });

  /* ---------- videos: en bucle solo mientras se ven; con «reducir movimiento», póster y botón ---------- */
  const videos = [...document.querySelectorAll<HTMLVideoElement>('[data-vid]')];
  if (reduce) {
    videos.forEach((v) => {
      const b = v.parentElement!.querySelector<HTMLButtonElement>('[data-vid-btn]')!;
      b.hidden = false;
      b.addEventListener('click', () => {
        if (v.paused) { v.play().catch(() => {}); b.setAttribute('aria-label', 'Pausar video'); b.querySelector('.ms')!.textContent = 'pause'; }
        else { v.pause(); b.setAttribute('aria-label', 'Reproducir video'); b.querySelector('.ms')!.textContent = 'play_arrow'; }
      });
    });
  } else if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
    }), { threshold: .35 });
    videos.forEach((v) => io.observe(v));
  }

  /* ---------- aparición suave al bajar ---------- */
  if (!reduce && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js-rv');
    const io = new IntersectionObserver((es, o) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); o.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.rv').forEach((el) => io.observe(el));
  }

  /* ---------- galería deslizable con puntos ---------- */
  const galeria = document.querySelector<HTMLElement>('[data-gal-track]')!;
  const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
  galeria.addEventListener('scroll', () => {
    const i = Math.round(galeria.scrollLeft / galeria.clientWidth);
    dots.forEach((d, j) => d.classList.toggle('is-on', j === i));
  }, { passive: true });

  /* ---------- barra fija: se oculta mientras se ven los botones de arriba o el cierre de compra ---------- */
  const mbar = document.querySelector<HTMLElement>('[data-mbar]')!;
  const visibles = new Set<Element>();
  const obs = new IntersectionObserver((es) => {
    es.forEach((e) => (e.isIntersecting ? visibles.add(e.target) : visibles.delete(e.target)));
    mbar.classList.toggle('is-off', visibles.size > 0);
  });
  obs.observe(document.querySelector('[data-ctas-hero]')!);
  document.addEventListener('ck:listo', () => mbar.classList.add('is-off'));
  obs.observe(document.getElementById('pedido')!);

  /* ---------- promoción: cuenta regresiva hasta su fecha real de fin ---------- */
  const promo = document.querySelector<HTMLElement>('[data-promo]');
  if (promo) {
    const fin = new Date(promo.dataset.promo!).getTime();
    const t = promo.querySelector<HTMLElement>('[data-promo-t]')!;
    const dos = (n: number) => String(n).padStart(2, '0');
    const tic = () => {
      const ms = fin - Date.now();
      if (ms <= 0) { promo.hidden = true; return false; }
      const d = Math.floor(ms / 864e5), h = Math.floor(ms / 36e5) % 24, m = Math.floor(ms / 6e4) % 60, sg = Math.floor(ms / 1e3) % 60;
      t.textContent = (d ? d + (d === 1 ? ' día ' : ' días ') : '') + dos(h) + ':' + dos(m) + ':' + dos(sg);
      promo.hidden = false;
      return true;
    };
    if (tic()) { const iv = window.setInterval(() => { if (!tic()) window.clearInterval(iv); }, 1000); }
  }

  /* ---------- reseñas publicadas ---------- */
  const lista = document.querySelector<HTMLElement>('[data-lista]')!;
  const prom = document.querySelector<HTMLElement>('[data-promedio]')!;
  const vacio = document.querySelector<HTMLElement>('[data-vacio]')!;
  const estrellasTxt = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
  const fecha = (iso: string) => new Date(iso).toLocaleDateString('es-CO', { day: 'numeric', month: 'short', year: 'numeric' });
  type Resena = { id: string; creado: string; nombre: string; ciudad: string | null; estrellas: number; comentario: string; foto: string | null };
  if (SB_URL && SB_KEY) {
    fetch(`${SB_URL}/rest/v1/resenas?select=id,creado,nombre,ciudad,estrellas,comentario,foto&producto=eq.${encodeURIComponent(D.slug!)}&estado=eq.publicada&order=creado.desc&limit=50`,
      { headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` } })
      .then((r) => (r.ok ? r.json() : []))
      .then((rs: Resena[]) => {
        if (!rs.length) return;
        vacio.hidden = true;
        const media = rs.reduce((s, x) => s + x.estrellas, 0) / rs.length;
        prom.hidden = false;
        const hs = document.querySelector<HTMLElement>('[data-hero-stars]')!;
        hs.querySelector('.stars')!.textContent = estrellasTxt(Math.round(media));
        hs.querySelector('[data-hero-stars-txt]')!.textContent = `${media.toFixed(1).replace('.', ',')} · ${rs.length} ${rs.length === 1 ? 'opinión' : 'opiniones'}`;
        hs.setAttribute('aria-label', `${media.toFixed(1).replace('.', ',')} de 5 estrellas, ${rs.length} ${rs.length === 1 ? 'opinión' : 'opiniones'}. Ver opiniones`);
        prom.innerHTML = `<span class="stars" aria-hidden="true">${estrellasTxt(Math.round(media))}</span><b>${media.toFixed(1).replace('.', ',')}</b> de 5 · ${rs.length} ${rs.length === 1 ? 'opinión' : 'opiniones'}`;
        lista.innerHTML = rs.map((x) => `<li class="resena">
          <div class="resena__top"><span class="stars" role="img" aria-label="${x.estrellas} de 5 estrellas">${estrellasTxt(x.estrellas)}</span><time datetime="${esc(x.creado)}">${fecha(x.creado)}</time></div>
          <p class="resena__txt">${esc(x.comentario)}</p>
          ${x.foto && x.foto.startsWith(SB_URL!) ? `<img class="resena__foto" src="${esc(x.foto)}" alt="Foto de ${esc(x.nombre)}" loading="lazy" decoding="async" />` : ''}
          <p class="resena__autor"><b>${esc(x.nombre)}</b>${x.ciudad ? ` · ${esc(x.ciudad)}` : ''}</p>
        </li>`).join('');
      })
      .catch(() => { /* sin reseñas si no carga */ });
  }

  /* ---------- dejar una reseña (queda pendiente hasta que el equipo la publique) ---------- */
  const formR = document.querySelector<HTMLFormElement>('[data-form-resena]')!;
  const fotoIn = formR.querySelector<HTMLInputElement>('#r-foto')!;
  const fotoPrev = formR.querySelector<HTMLImageElement>('[data-foto-prev]')!;
  let fotoBlob: Blob | null = null;

  const comprimir = async (file: File, max = 1200): Promise<Blob> => {
    const img = await createImageBitmap(file);
    const k = Math.min(1, max / Math.max(img.width, img.height));
    const c = document.createElement('canvas');
    c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
    c.getContext('2d')!.drawImage(img, 0, 0, c.width, c.height);
    return new Promise((ok, mal) => c.toBlob((b) => (b ? ok(b) : mal(new Error('foto'))), 'image/webp', 0.82));
  };
  fotoIn.addEventListener('change', async () => {
    const file = fotoIn.files?.[0];
    formR.querySelector('#r-foto-err')!.classList.remove('is-on');
    if (!file) return;
    try {
      fotoBlob = await comprimir(file);
      if (fotoBlob.size > 3 * 1024 * 1024) throw new Error('grande');
      fotoPrev.src = URL.createObjectURL(fotoBlob);
      fotoPrev.hidden = false;
      formR.querySelector('[data-foto-txt]')!.textContent = 'Cambiar la foto';
    } catch {
      fotoBlob = null; fotoPrev.hidden = true;
      formR.querySelector('#r-foto-err')!.classList.add('is-on');
    }
  });

  const v = (n: string) => ((formR.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '').trim();
  const estrellas = () => Number(formR.querySelector<HTMLInputElement>('[name="estrellas"]:checked')?.value ?? 0);
  const reglas: [string, () => boolean, string][] = [
    ['estrellas', () => estrellas() > 0, 'r-e5'],
    ['nombre', () => v('nombre').length > 0, 'r-nombre'],
    ['comentario', () => v('comentario').length >= 3, 'r-comentario'],
    ['datos', () => formR.querySelector<HTMLInputElement>('#r-datos')!.checked, 'r-datos']
  ];
  let enviando = false;
  formR.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (enviando) return;
    let primero: HTMLElement | null = null;
    for (const [k, ok, id] of reglas) {
      const malo = !ok();
      const err = document.getElementById(`r-${k}-err`)!;
      err.classList.toggle('is-on', malo);
      const campo = document.getElementById(id)!;
      campo.setAttribute('aria-invalid', String(malo));
      if (malo) campo.setAttribute('aria-describedby', err.id); else campo.removeAttribute('aria-describedby');
      if (malo && !primero) primero = campo;
    }
    if (primero) { primero.focus(); return; }

    enviando = true;
    const btn = formR.querySelector<HTMLButtonElement>('[data-enviar-resena]')!;
    btn.disabled = true; btn.textContent = 'Enviando…';
    const fallo = formR.querySelector<HTMLElement>('[data-resena-fallo]')!;
    fallo.hidden = true;

    let ok = false;
    try {
      let foto: string | null = null;
      if (fotoBlob && SB_URL && SB_KEY) {
        const ruta = `${D.slug}/${Date.now()}-${Math.random().toString(36).slice(2, 8)}.webp`;
        const r = await fetch(`${SB_URL}/storage/v1/object/resenas/${ruta}`, {
          method: 'POST', headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'image/webp', 'cache-control': '31536000' }, body: fotoBlob
        });
        if (r.ok) foto = `${SB_URL}/storage/v1/object/public/resenas/${ruta}`;
      }
      const res = !supabaseReady && enArchivo ? 'ok' : await insert('resenas', {
        producto: D.slug, nombre: v('nombre'), ciudad: v('ciudad') || null, estrellas: estrellas(), comentario: v('comentario'), foto,
        acepto_datos: true, version_politicas: D.legal
      });
      ok = res === 'ok';
    } catch { ok = false; }

    enviando = false;
    btn.disabled = false; btn.textContent = 'Enviar opinión';
    if (ok) {
      formR.hidden = true;
      const g = document.querySelector<HTMLElement>('[data-resena-ok]')!;
      g.hidden = false;
      g.querySelector<HTMLElement>('[data-resena-ok-h]')!.focus();
    } else fallo.hidden = false;
  });
</script>

<style>
  /* ---------- barra superior ---------- */
  .lp-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 2px 8px; padding: 8px 12px; background: var(--ink); color: #fff; font: 500 13.5px/1.3 var(--font-sans); text-align: center; }
  .lp-bar > span { display: inline-flex; align-items: center; gap: 6px; }
  .lp-bar .ms { font-size: 18px; color: var(--peach); }
  .lp-bar b { font-weight: 700; color: var(--peach); }
  .lp-bar__dot { opacity: .6; }
  @media (max-width: 439px) { .lp-bar .ms { display: none; } }
  @media (min-width: 440px) { .lp-bar { font-size: 14px; } }

  .lp { --gap: 20px; }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; padding-top: 12px; padding-bottom: 12px; font: 500 14px/1.3 var(--font-sans); color: var(--ink-muted); }
  .crumbs a { color: var(--primary); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs .ms { font-size: 16px; }
  .crumbs [aria-current] { color: var(--ink); }
  .h2 { font: 400 clamp(28px, 6.4vw, 44px)/1.08 var(--font-serif); letter-spacing: -.02em; color: var(--ink); }
  .h2 b { font-weight: 700; }
  .h3 { display: flex; align-items: center; gap: 8px; font: 700 22px/1.2 var(--font-serif); }
  .h3 .ms { color: var(--primary); font-size: 24px; }
  .txt { font: 400 17px/1.6 var(--font-sans); color: var(--ink-muted); }
  .txt b { color: var(--ink); }
  .cap, figcaption { font: 500 15px/1.4 var(--font-sans); color: var(--ink-muted); }
  figure { margin: 0; }
  .foto { width: 100%; height: auto; border-radius: 22px; background: var(--surface-3); }

  /* ---------- botones ---------- */
  .cta { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 56px; padding: 0 24px; border-radius: 999px; border: 0; background: var(--primary); color: #fff; font: 700 17px/1.2 var(--font-sans); text-align: center; text-decoration: none; cursor: pointer; box-shadow: 0 6px 16px rgb(77 63 108 / .28); transition: background .2s, transform .2s var(--ease-out); }
  .cta:hover { background: var(--primary-strong); color: #fff; }
  .cta:active { transform: scale(.98); }
  .cta:disabled { opacity: .7; cursor: progress; }
  .cta--full { width: 100%; }
  .wa-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 22px; border-radius: 999px; background: var(--wa); color: var(--wa-dark); font: 700 16px/1.2 var(--font-sans); text-decoration: none; transition: filter .2s; }
  .wa-btn:hover { color: var(--wa-dark); filter: brightness(1.06); }
  .wa-btn--lg { min-height: 56px; width: 100%; }

  /* ---------- primera pantalla ---------- */
  .hero { display: grid; gap: 18px; padding-bottom: 32px; }
  .hero__portada { position: relative; aspect-ratio: 3 / 4; max-height: 82svh; overflow: hidden; background: var(--lavender); }
  .hero__portada img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 70%; }
  .hero__h1 { position: absolute; left: 0; right: 0; top: 9%; padding: 0 var(--gutter); font: 700 clamp(36px, 10.5vw, 60px)/1 var(--font-serif); letter-spacing: -.03em; color: var(--ink); text-shadow: 0 1px 0 rgb(255 255 255 / .5); }
  .hero__h1 span { display: block; margin-top: 6px; font-size: .52em; font-weight: 400; letter-spacing: -.01em; color: var(--primary-strong); }
  .hero__info { display: flex; flex-direction: column; gap: 18px; padding-inline: var(--gutter); }
  .hero__sub { font: 400 19px/1.5 var(--font-sans); color: var(--ink-muted); }
  .precio { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; }
  .hero__stars { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; font: 600 14.5px/1 var(--font-sans); color: var(--ink-muted); text-decoration: none; }
  .hero__stars:hover { color: var(--primary-strong); text-decoration: underline; }
  .hero__stars .stars { font-size: 20px; }
  .antes { font: 500 20px/1 var(--font-sans); color: var(--ink-soft); }
  .off { display: inline-flex; align-items: center; min-height: 30px; padding: 0 10px; border-radius: 999px; background: #B4271F; color: #fff; font: 700 14px/1 var(--font-sans); }
  .promo { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 16px; background: #FDEBDD; color: var(--peach-ink); font: 500 15px/1.35 var(--font-sans); }
  .promo .ms { font-size: 24px; color: #B4571F; }
  .promo b { font-variant-numeric: tabular-nums; color: var(--ink); }
  .precio > b { font: 700 40px/1 var(--font-sans); letter-spacing: -.02em; margin-right: 4px; }
  .sello { display: inline-flex; align-items: center; gap: 6px; min-height: 34px; padding: 0 12px; border-radius: 999px; font: 700 14px/1 var(--font-sans); }
  .sello .ms { font-size: 18px; }
  .sello--peach { background: var(--peach); color: var(--peach-ink); }
  .sello--lav { background: var(--lavender); color: #372C42; }
  .puntos { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .puntos li { display: flex; gap: 12px; align-items: flex-start; font: 400 16.5px/1.45 var(--font-sans); }
  .puntos .ms { flex: none; width: 36px; height: 36px; font-size: 22px; border-radius: 12px; display: grid; place-items: center; background: var(--surface-3); color: var(--primary); }
  .ctas { display: grid; gap: 10px; }

  /* galería deslizable */
  .gal { padding-inline: var(--gutter); }
  .gal__track { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: 22px; }
  .gal__track::-webkit-scrollbar { display: none; }
  .gal__slide { flex: 0 0 100%; scroll-snap-align: center; aspect-ratio: 1; border-radius: 22px; overflow: hidden; background: var(--surface-3); }
  .gal__slide > img, .gal__slide .vid, .gal__slide video { width: 100%; height: 100%; object-fit: cover; }
  .gal__dots { display: flex; justify-content: center; gap: 6px; margin-top: 10px; }
  .gal__dots span { width: 8px; height: 8px; border-radius: 4px; background: var(--line); transition: width .25s var(--ease-out), background .2s; }
  .gal__dots span.is-on { width: 22px; background: var(--primary); }

  /* videos */
  .vid { position: relative; overflow: hidden; background: var(--surface-3); }
  .vid video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .vid--card { border-radius: 22px; aspect-ratio: 3 / 4; }
  .vid__btn { position: absolute; right: 12px; bottom: 12px; width: 48px; height: 48px; border-radius: 50%; border: 0; display: grid; place-items: center; background: rgb(255 255 255 / .92); color: var(--primary-strong); cursor: pointer; box-shadow: var(--shadow-1); }
  .vid__btn .ms { font-size: 28px; }

  /* ---------- bloques ---------- */
  .blq { padding-block: var(--section); }
  .blq--lav, .blq--peach { border-radius: 24px; }
  .blq--lav { background: #EFE6F3; }
  .blq--peach { background: #FDEBDD; }
  .wrap.blq--lav, .wrap.blq--peach { width: calc(100% - 2 * 12px); margin-inline: auto; padding-inline: calc(var(--gutter) - 4px); }
  section.blq--peach { margin-inline: 12px; }
  .split { display: grid; gap: 24px; align-items: center; }
  .split__txt { display: flex; flex-direction: column; gap: 16px; }
  .split__media { display: flex; flex-direction: column; gap: 10px; }
  .gota { width: 56px; height: 56px; border-radius: 18px; display: grid; place-items: center; background: #fff; color: var(--primary); }
  .gota .ms { font-size: 30px; }

  .pasos { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .pasos li { display: flex; gap: 14px; align-items: flex-start; font: 400 17px/1.5 var(--font-sans); color: var(--ink-muted); }
  .pasos li b { color: var(--ink); }
  .pasos__n { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--grad-alma); color: #362954; font: 700 16px/1 var(--font-sans); }
