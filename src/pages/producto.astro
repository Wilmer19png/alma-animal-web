---
// Ficha de producto: /producto?p=shampoo-hipoalergenico. Una sola página que lee el producto de Supabase,
// así los productos nuevos o los cambios del gestor se ven sin volver a publicar el sitio.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WaIcon from '../components/WaIcon.astro';
import SalesBuzz from '../components/SalesBuzz.astro';
import '../styles/tienda.css';
import { whatsapp } from '../data/site';
import { SHIPPING, GIFT, money, CIUDADES } from '../data/shop';
const waShop = whatsapp.shop('Hola, Alma Animal. Tengo una pregunta sobre un producto.');
---
<Base
  title="Producto · Petshop Alma Animal"
  description={`Alimento, higiene y accesorios recomendados por la doctora. Envío gratis en ${CIUDADES}, y a toda Colombia desde ${money(SHIPPING.freeFrom)}.`}
  waMessage="Hola, Alma Animal. Tengo una pregunta sobre un producto."
  waArea="shop"
>
  <SiteHeader slot="top" />
  <div class="pdp">
    <!-- ======== ENVÍO GRATIS: se llena con lo que hay en el carrito ======== -->
    <div class="wrap">
      <div class="shipline" role="status" data-shipline>
        <span class="ms" aria-hidden="true">local_shipping</span>
        <span class="shipline__txt" data-ship-msg>Envío gratis a toda Colombia desde <b>{money(SHIPPING.freeFrom)}</b></span>
        <span class="shipline__bar" aria-hidden="true"><i data-ship-bar data-free-fill></i></span>
        <span class="shipline__note">En {CIUDADES} siempre es gratis</span>
      </div>
    </div>

    <nav class="wrap crumbs" aria-label="Estás en">
      <a href="/petshop">Petshop</a><span class="ms" aria-hidden="true">chevron_right</span>
      <a href="/petshop" data-crumb-cat>…</a><span class="ms" aria-hidden="true">chevron_right</span>
      <span aria-current="page" data-crumb-name>…</span>
    </nav>

    <!-- ======== PRODUCTO (se dibuja al cargar) ======== -->
    <section class="wrap product" aria-labelledby="pn" data-product aria-busy="true">
      <div class="gallery"><div class="gallery__main is-loading"></div></div>
      <div class="info" data-info><p class="info__loading">Cargando el producto…</p></div>
    </section>

    <section class="wrap missing" data-missing hidden>
      <span class="ms" aria-hidden="true">search</span>
      <h1>No encontramos este producto</h1>
      <p>Puede que ya no esté a la venta. Mira lo que tenemos en la tienda o escríbenos.</p>
      <div class="missing__acts"><a class="btn btn--alma" href="/petshop">Ver la tienda</a><a class="wa-o" href={waShop} target="_blank" rel="noopener"><WaIcon size={22} />Preguntar por WhatsApp</a></div>
    </section>

    <!-- partes fijas de la ficha (se insertan dentro de la información) -->
    <template data-fixed>
      <a class="wa-o" data-ask href={waShop} target="_blank" rel="noopener"><WaIcon size={22} />¿Es el indicado? Pregúntale a la doctora</a>
      <p class="gift" data-gift hidden={!GIFT.active}><span class="ms" aria-hidden="true">redeem</span><span data-gift-txt>En compras desde <b>{money(GIFT.from)}</b> te llevas un <b>obsequio</b>.</span></p>
      <ul class="perks">
        <li><span class="ms" aria-hidden="true">local_shipping</span>Envío gratis en {CIUDADES}</li>
        <li><span class="ms" aria-hidden="true">public</span>Gratis a toda Colombia en compras desde {money(SHIPPING.freeFrom)}</li>
        {SHIPPING.priority > 0 && <li><span class="ms" aria-hidden="true">bolt</span>Envío prioritario por {money(SHIPPING.priority)}</li>}
      </ul>
    </template>

    <!-- ======== LO QUE DEBES SABER (beneficios, qué trae, cómo darlo, preguntas: columna ficha) ======== -->
    <section class="wrap fx" aria-labelledby="fx-t" data-fx hidden></section>

    <!-- ======== RELACIONADOS ======== -->
    <section class="wrap related" aria-labelledby="rel" data-related hidden>
      <h2 id="rel" class="h-section">Te puede <b class="gt">interesar</b></h2>
      <div class="related__grid" data-related-grid></div>
    </section>
  </div>

  <SalesBuzz />
</Base>

<script>
  import { cart, progress, money } from '../scripts/cart';
  import { LANDINGS, CODORNICES, catalogo, tarjeta, stockDe, itemCarrito, categoria, paraTxt, etiquetas, descuento, esc, portada, TONOS, type Producto, type Variante } from '../scripts/catalogo';
  import { supabaseReady } from '../scripts/supabase';
  import { TAGS, SHIPPING } from '../data/shop';
  import { avisarAgregado } from '../scripts/add-buttons';
  import { track } from '../scripts/meta';

  const SHOP = '573017925910';
  const slug = new URLSearchParams(location.search).get('p') ?? '';
  if (LANDINGS[slug]) location.replace(LANDINGS[slug] + location.search.replace(/[?&]p=[^&]*/, '').replace(/^&/, '?'));
  const section = document.querySelector<HTMLElement>('[data-product]')!;
  const info = document.querySelector<HTMLElement>('[data-info]')!;
  const gallery = section.querySelector<HTMLElement>('.gallery')!;
  const wa = (t: string) => `https://wa.me/${SHOP}?text=${encodeURIComponent(t)}`;
  const sub = (v: Variante) => (v.stock <= 0 ? 'Agotado' : v.stock <= 3 ? `${money(v.precio)} · últimas ${v.stock}` : money(v.precio));

  /* ---------- galería: fotos con miniaturas, o el ícono si aún no hay fotos ---------- */
  function galeria(p: Producto) {
    const stock = stockDe(p);
    const pill = `<span class="stock${stock === 0 ? ' out' : stock <= 3 ? ' low' : ''}">${stock === 0 ? 'Agotado' : 'En stock'}</span>`;
    const bg = TONOS[p.tono] ?? TONOS.lav;
    if (!p.fotos.length) {
      gallery.innerHTML = `<div class="gallery__main" style="background:${bg}"><span class="ms" aria-hidden="true">${esc(p.icono)}</span>${pill}</div>`;
      return;
    }
    const n = p.fotos.length;
    gallery.innerHTML = `<div class="gallery__main has-foto" style="background:${bg}" aria-roledescription="carrusel" aria-label="Fotos de ${esc(p.nombre)}">
        ${p.fotos.map((f, i) => `<img src="${esc(f)}" alt="${esc(p.nombre)}, foto ${i + 1} de ${n}" ${i ? 'hidden loading="lazy"' : ''} decoding="async" />`).join('')}
        ${pill}
        ${n > 1 ? '<span class="gallery__nav"><button type="button" data-g="-1" aria-label="Foto anterior"><span class="ms">arrow_back</span></button><button type="button" data-g="1" aria-label="Foto siguiente"><span class="ms">arrow_forward</span></button></span>' : ''}
      </div>
      ${n > 1 ? `<div class="gallery__thumbs">${p.fotos.map((f, i) => `<button type="button" data-t="${i}" aria-label="Ver foto ${i + 1}" aria-pressed="${i === 0}"><img src="${esc(f)}" alt="" loading="lazy" /></button>`).join('')}</div>` : ''}`;
    if (n < 2) return;
    const imgs = [...gallery.querySelectorAll<HTMLImageElement>('.gallery__main img')];
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-t]')];
    let i = 0, timer: number | undefined;
    const show = (k: number) => { i = (k + n) % n; imgs.forEach((im, j) => { im.hidden = j !== i; }); thumbs.forEach((t, j) => t.setAttribute('aria-pressed', String(j === i))); };
    const auto = () => { window.clearInterval(timer); if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = window.setInterval(() => show(i + 1), 3500); };
    gallery.querySelectorAll<HTMLButtonElement>('[data-g]').forEach((b) => b.addEventListener('click', () => { show(i + Number(b.dataset.g)); auto(); }));
    thumbs.forEach((t) => t.addEventListener('click', () => { show(Number(t.dataset.t)); auto(); }));
    gallery.addEventListener('mouseenter', () => window.clearInterval(timer));
    gallery.addEventListener('mouseleave', auto);
    auto();
  }

  /* ---------- lo que debes saber: beneficios, qué trae, para quién, cómo darlo y preguntas ---------- */
  function saber(p: Producto) {
    const f = p.ficha;
    if (!f) return;
    const el = document.querySelector<HTMLElement>('[data-fx]')!;
    const lista = (t: string, xs?: string[]) => (xs?.length ? `<div class="fx__box"><h3>${t}</h3><ul>${xs.map((x) => `<li>${esc(x)}</li>`).join('')}</ul></div>` : '');
    el.innerHTML = `
      <h2 id="fx-t" class="h-section">Lo que debes <b class="gt">saber</b></h2>
      ${f.checks?.length ? `<ul class="fx__checks">${f.checks.map((c) => `<li><span class="ms" aria-hidden="true">check_circle</span>${esc(c)}</li>`).join('')}</ul>` : ''}
      ${f.trae?.length ? `<div class="fx__trae"><h3>Qué trae</h3><ul>${f.trae.map(([n, t, d]) => `<li><b>${esc(n)}</b><span><b>${esc(t)}</b>${esc(d)}</span></li>`).join('')}</ul></div>` : ''}
      ${f.beneficios?.length ? `<div class="fx__ben">${f.beneficios.map(([t, d]) => `<div><h3>${esc(t)}</h3><p>${esc(d)}</p></div>`).join('')}</div>` : ''}
      <div class="fx__cols">${lista('¿Para quién es?', f.para_quien)}${lista('Ideal para', f.uso)}</div>
      ${f.como_darlo?.length ? `<div class="fx__box"><h3>Cómo darlo</h3><ol>${f.como_darlo.map((x) => `<li>${esc(x)}</li>`).join('')}</ol></div>` : ''}
      ${f.preguntas?.length ? `<div class="fx__faq"><h3>Preguntas frecuentes</h3>${f.preguntas.map(([q, a]) => `<details><summary>${esc(q)}</summary><p>${esc(a)}</p></details>`).join('')}</div>` : ''}`;
    el.hidden = false;
  }

  /* ---------- recomendación: codornices deshidratadas (bolsa o frasco) ---------- */
  function recomendar(p: Producto, lista: Producto[]) {
    const cod = lista.find((x) => x.slug === CODORNICES);
    if (!cod || p.slug === CODORNICES) return;
    const vs = cod.variantes.filter((v) => v.stock > 0);
    if (!vs.length) return;
    const box = document.createElement('div');
    box.className = 'reco';
    box.innerHTML = `
      <a class="reco__img" href="${location.protocol === 'file:' ? './producto.html' : '/producto'}?p=${CODORNICES}" style="background:${TONOS[cod.tono] ?? TONOS.lav}" tabindex="-1" aria-hidden="true">${portada(cod)}</a>
      <div class="reco__txt">
        <span class="reco__k">Súmale el favorito</span>
        <b>${esc(cod.nombre)}</b>
        <span>Codorniz 100 % natural, para perros y gatos. En bolsa o en frasco.</span>
        <div class="reco__btns">${vs.map((v) => `<button type="button" class="reco__add" data-add='${esc(JSON.stringify(itemCarrito(cod, v)))}' aria-label="Agregar ${esc(cod.nombre)} ${esc(v.nombre)} al carrito"><span class="ms" aria-hidden="true">add</span>${esc(v.nombre)} · ${money(v.precio)}</button>`).join('')}</div>
      </div>`;
    info.querySelector('[data-added]')!.after(box);
  }

  /* ---------- información, variantes y compra ---------- */
  function ficha(p: Producto) {
    const words = p.nombre.split(' ');
    const multi = p.variantes.length > 1;
    const kind = p.tipo ?? 'Presentación';
    const start = p.variantes.find((v) => v.stock > 0) ?? p.variantes[0];
    const tags = etiquetas(p).map((t) => `<span class="tag ${TAGS[t].tone}">${TAGS[t].label}</span>`).join('');
    const specs = [...(multi ? [[kind, start.nombre] as [string, string]] : []), ['Para', paraTxt(p)] as [string, string], ...(p.marca ? [['Marca', p.marca] as [string, string]] : []), ...p.caracteristicas];
    info.innerHTML = `
      <div class="info__meta"><span class="info__cat">${categoria(p.categoria)} · ${paraTxt(p)}</span>${tags}</div>
      <h1 id="pn">${esc(words.slice(0, -1).join(' '))} <b class="gt">${esc(words[words.length - 1])}</b></h1>
      <div class="price"><b data-price></b><s data-was hidden></s><span class="off" data-off hidden></span>${supabaseReady ? '' : '<span class="price__note">Precio de ejemplo</span>'}</div>
      ${p.descripcion ? `<p class="info__text">${esc(p.descripcion)}</p>` : ''}
      ${multi ? `<fieldset class="vars"><legend>${esc(kind)}: <span data-var-name></span></legend><div class="vars__list">
        ${p.variantes.map((v) => `<label class="var${v.stock <= 0 ? ' is-out' : ''}"><input type="radio" name="variante" value="${esc(v.id)}"${v === start ? ' checked' : ''} /><b>${esc(v.nombre)}</b><span>${sub(v)}</span></label>`).join('')}
      </div></fieldset>` : ''}
      <p class="soldout" data-soldout hidden>${multi ? `Esta ${esc(kind.toLowerCase())} está agotada.` : 'Este producto está agotado.'} <a href="#" data-notify target="_blank" rel="noopener">Avísame por WhatsApp cuando llegue</a></p>
      <dl class="specs">${specs.map(([k, v], j) => `<div class="${v.length > 28 ? 'wide' : ''}"><dt>${esc(k)}</dt><dd${multi && j === 0 ? ' data-var-name' : ''}>${esc(v)}</dd></div>`).join('')}</dl>
      <div class="buy" data-buy>
        <span class="qty" role="group" aria-label="Cantidad"><button type="button" aria-label="Quitar uno" data-dec>−</button><output aria-live="polite" data-qty>1</output><button type="button" aria-label="Agregar uno" data-inc>+</button></span>
        <button class="cta" type="button" data-cta><span class="ms" aria-hidden="true">shopping_bag</span><span data-cta-txt></span></button>
      </div>
      <p class="nudge" data-nudge hidden></p>
      <div class="added" role="status" data-added hidden><span><span class="ms" aria-hidden="true">check_circle</span><span data-added-txt>Agregado al carrito</span></span><a href="${location.protocol === 'file:' ? './carrito.html' : '/carrito'}">Ver carrito</a></div>`;
    info.append(document.querySelector<HTMLTemplateElement>('[data-fixed]')!.content.cloneNode(true));
    info.querySelector<HTMLAnchorElement>('[data-ask]')!.href = wa(`Hola, Alma Animal. Tengo una pregunta sobre ${p.nombre}. ¿Es el indicado para mi mascota?`);

    const radios = [...info.querySelectorAll<HTMLInputElement>('input[name="variante"]')];
    const cta = info.querySelector<HTMLButtonElement>('[data-cta]')!;
    const added = info.querySelector<HTMLElement>('[data-added]')!;
    let qty = 1;
    const actual = () => p.variantes.find((v) => v.id === radios.find((r) => r.checked)?.value) ?? start;
    const paint = () => {
      const v = actual();
      const out = v.stock <= 0;
      qty = Math.max(1, Math.min(qty, v.stock || 1));
      info.querySelector('[data-qty]')!.textContent = String(qty);
      info.querySelector('[data-price]')!.textContent = money(v.precio);
      const was = info.querySelector<HTMLElement>('[data-was]')!;
      const pct = descuento(v), off = info.querySelector<HTMLElement>('[data-off]')!;
      was.hidden = !pct; was.textContent = pct ? money(v.antes!) : '';
      off.hidden = !pct; off.textContent = pct ? `-${pct}%` : '';
      info.querySelectorAll('[data-var-name]').forEach((el) => { el.textContent = v.nombre; });
      info.querySelector<HTMLElement>('[data-soldout]')!.hidden = !out;
      info.querySelector<HTMLAnchorElement>('[data-notify]')!.href = wa(`Hola, Alma Animal. Avísenme cuando llegue ${p.nombre}${multi ? ' · ' + v.nombre : ''}.`);
      cta.disabled = out;
      info.querySelector('[data-cta-txt]')!.textContent = out ? 'Agotado' : `Agregar · ${money(v.precio * qty)}`;
      info.querySelector<HTMLButtonElement>('[data-dec]')!.disabled = qty <= 1 || out;
      info.querySelector<HTMLButtonElement>('[data-inc]')!.disabled = qty >= v.stock || out;
      // de a una unidad: cuántas más hacen que el envío salga gratis
      const nudge = info.querySelector<HTMLElement>('[data-nudge]')!;
      const falta = SHIPPING.freeFrom - cart.subtotal() - v.precio * qty;
      const n = Math.ceil((SHIPPING.freeFrom - cart.subtotal()) / v.precio);
      nudge.hidden = out || falta <= 0;
      if (!nudge.hidden) nudge.innerHTML = n <= 6 && n > qty && n <= v.stock
        ? `<span class="ms" aria-hidden="true">local_shipping</span><span>Lleva <b>${n}</b> y tu envío sale <b>gratis</b> a toda Colombia. <button type="button" data-poner="${n}">Llevar ${n}</button></span>`
        : `<span class="ms" aria-hidden="true">local_shipping</span><span>Te faltan <b>${money(falta)}</b> para el envío <b>gratis</b>. Súmale unas codornices o un combo.</span>`;
    };
    info.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-poner]'); if (b) { qty = Number(b.dataset.poner); paint(); } });
    cart.onChange(() => paint());
    radios.forEach((r) => r.addEventListener('change', () => { qty = 1; added.hidden = true; paint(); }));
    info.querySelector('[data-dec]')!.addEventListener('click', () => { qty--; paint(); });
    info.querySelector('[data-inc]')!.addEventListener('click', () => { qty++; paint(); });
    cta.addEventListener('click', () => {
      const it = itemCarrito(p, actual());
      cart.add(it, qty);
      avisarAgregado(it, qty);
      info.querySelector('[data-added-txt]')!.textContent = `${qty > 1 ? qty + ' agregados' : 'Agregado'} al carrito`;
      added.hidden = false;
      cta.classList.remove('hop'); void cta.offsetWidth; cta.classList.add('hop');
    });
    paint();
    paintCart();
  }

  /* ---------- envío gratis y obsequio según el carrito ---------- */
  function paintCart() {
    const s = cart.subtotal();
    if (!s) return;
    const p = progress(s);
    document.querySelector('[data-ship-msg]')!.innerHTML = p.toFree > 0 ? `Te faltan <b>${money(p.toFree)}</b> para envío gratis<span class="hide-sm"> a toda Colombia</span>` : '<b>¡Ya tienes envío gratis</b><span class="hide-sm"> a toda Colombia</span>!';
    const bar = document.querySelector<HTMLElement>('[data-ship-bar]')!;
    bar.style.width = p.freePct + '%';
    bar.classList.toggle('is-full', p.freePct >= 100);
    const gift = document.querySelector('[data-gift-txt]');
    if (gift) gift.innerHTML = p.toGift > 0 ? `Agrega <b>${money(p.toGift)}</b> más a tu carrito y llévate un <b>obsequio</b>.` : '¡Tu pedido ya lleva un <b>snack dental</b> de obsequio!';
  }
  paintCart();
  cart.onChange(paintCart);

  /* ---------- cargar ---------- */
  catalogo().then((lista) => {
    const p = lista.find((x) => x.slug === slug);
    section.removeAttribute('aria-busy');
    if (!p) { section.hidden = true; document.querySelector<HTMLElement>('[data-missing]')!.hidden = false; document.querySelector('.crumbs')!.setAttribute('hidden', ''); return; }
    document.title = `${p.nombre} · Petshop Alma Animal`;
    document.querySelector('meta[name="description"]')?.setAttribute('content', p.descripcion || p.nombre);
    const cat = document.querySelector<HTMLAnchorElement>('[data-crumb-cat]')!;
    cat.textContent = categoria(p.categoria); cat.href = (location.protocol === 'file:' ? './petshop.html' : '/petshop') + '#' + p.categoria;
    document.querySelector('[data-crumb-name]')!.textContent = p.nombre;
    galeria(p);
    ficha(p);
    saber(p);
    recomendar(p, lista);
    const v0 = p.variantes.find((v) => v.stock > 0) ?? p.variantes[0];
    track('ViewContent', { content_ids: [p.id], content_type: 'product', content_name: p.nombre, content_category: categoria(p.categoria), value: v0?.precio ?? 0, currency: 'COP' });
    // relacionados: primero la misma categoría, luego los destacados
    const rel = lista.filter((x) => x.slug !== p.slug && stockDe(x) > 0)
      .sort((a, b) => Number(b.categoria === p.categoria) - Number(a.categoria === p.categoria) || a.orden - b.orden).slice(0, 4);
    if (rel.length) {
      document.querySelector('[data-related-grid]')!.innerHTML = rel.map(tarjeta).join('');
      document.querySelector<HTMLElement>('[data-related]')!.hidden = false;
    }
  }).catch(() => {
    section.hidden = true;
    const m = document.querySelector<HTMLElement>('[data-missing]')!;
    m.querySelector('h1')!.textContent = 'No pudimos cargar el producto';
    m.querySelector('p')!.textContent = 'Revisa tu conexión y vuelve a intentarlo, o escríbenos por WhatsApp.';
    m.hidden = false;
  });
</script>

<style is:global>
  /* ---------- ENVÍO GRATIS ---------- */
  .pdp .shipline { position: relative; overflow: hidden; display: flex; align-items: center; gap: 10px; padding: 12px 16px 14px; border-radius: 999px; background: var(--surface-3); }
  .pdp .shipline > .ms { font-size: 20px; color: var(--primary); }
  .pdp .shipline__txt { flex: 1; min-width: 0; font: 500 14.5px/1.3 var(--font-sans); }
  .pdp .shipline__txt .hide-sm { display: none; }
  .pdp .shipline__bar { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: rgb(101 87 133 / .12); }
  .pdp .shipline__bar i { display: block; width: 0; height: 100%; background: var(--grad-primary); transition: width .8s var(--ease); }
  .pdp .shipline__note { display: none; }
  @media (min-width: 900px) {
    .pdp .shipline { gap: 16px; padding: 14px 22px; }
    .pdp .shipline > .ms { font-size: 24px; }
    .pdp .shipline__txt { flex: none; font-size: 16px; }
    .pdp .shipline__txt .hide-sm { display: inline; }
    .pdp .shipline__bar { position: static; flex: 1; min-width: 80px; height: 8px; border-radius: 999px; overflow: hidden; background: #E6E1E7; }
    .pdp .shipline__bar i { border-radius: 999px; }
    .pdp .shipline__note { display: inline; font-size: 15px; color: var(--ink-muted); white-space: nowrap; }
  }

  .pdp .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; padding-top: 18px; padding-bottom: 18px; font: 500 14px/1.3 var(--font-sans); color: var(--ink-muted); }
  .pdp .crumbs a { color: var(--primary); text-decoration: none; }
  .pdp .crumbs a:hover { text-decoration: underline; }
  .pdp .crumbs .ms { font-size: 16px; }
  .pdp .crumbs [aria-current] { color: var(--ink); }

  /* ---------- PRODUCTO ---------- */
  .pdp .product { display: grid; gap: 24px; align-items: start; padding-bottom: var(--section); }
  .pdp .gallery__main { position: relative; aspect-ratio: 1; border-radius: var(--r-md); display: grid; place-items: center; color: rgb(54 41 84 / .5); overflow: hidden; }
  .pdp .gallery__main > .ms { font-size: 120px; }
  .pdp .stock { position: absolute; top: 16px; left: 16px; font: 600 13px/1 var(--font-sans); padding: 8px 12px; border-radius: 999px; background: #B8F1B9; color: #1D5128; }
  .pdp .stock.low { background: #FFDDB2; color: #624000; }
  .pdp .stock.out { background: #fff; color: var(--ink-muted); }

  .pdp .info { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
