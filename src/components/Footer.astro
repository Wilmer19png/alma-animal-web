---
import { Image } from 'astro:assets';
import paper from '../assets/papel-tigre-perro-v3.png';
import { PHONES, ADDRESS, HOURS, SOCIAL, DOCTOR } from '../data/site';
---
<div class="wrap foot-wrap">
  <footer id="contacto" class="foot on-dark">
    <Image src={paper} alt="" width={520} class="foot__art" />
    <h2 class="foot__title">Te esperamos en <b class="gt">Pereira</b></h2>
    <div class="foot__grid">
      <div class="foot__col">
        <span class="foot__k">Dirección</span>
        <span>{ADDRESS.city}</span>
        <span>{ADDRESS.line}</span>
      </div>
      <div class="foot__col">
        <span class="foot__k">Teléfonos y WhatsApp</span>
        {Object.values(PHONES).map((p) => <a href={`tel:+${p.e164}`}>{p.label}: {p.display}</a>)}
      </div>
      <div class="foot__col">
        <span class="foot__k">Horario</span>
        {HOURS.map((h) => <span>{h.days}: {h.time}</span>)}
      </div>
      <div class="foot__col">
        <span class="foot__k">Síguenos</span>
        {SOCIAL.instagram.map((s) => (
          <a class="social" href={s.url} rel="noopener" target="_blank">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>{s.handle}
          </a>
        ))}
        {SOCIAL.facebook && (
          <a class="social" href={SOCIAL.facebook} rel="noopener" target="_blank">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8v3h2.5V21h3z"/></svg>Facebook
          </a>
        )}
      </div>
    </div>
    <div class="foot__cta">
      <a class="btn btn--alma" href="/consultorio#agendar">Agenda tu cita</a>
      <a class="btn btn--ghost" href={ADDRESS.maps} rel="noopener" target="_blank"><span class="ms" aria-hidden="true">map</span>Cómo llegar</a>
    </div>
    <div class="foot__bottom">
      <nav aria-label="Pie de página">
        <a href="/consultorio">Consultorio</a><a href="/spa">Spa</a><a href="/petshop">Petshop</a><a href="/blog">Blog</a>
      </nav>
      <span>{DOCTOR.name} · MVZ · {DOCTOR.tp} · <a href="/privacidad">Política de tratamiento de datos (Ley 1581 de 2012)</a></span>
    </div>
  </footer>
</div>

<style>
  .foot-wrap { padding-bottom: var(--gutter); }
  .foot { position: relative; overflow: hidden; isolation: isolate; border-radius: var(--r-lg); background: var(--ink); color: #fff; padding: 36px 20px 24px; }
  .foot a { color: #fff; text-decoration: none; }
  .foot a:hover { color: #fff; text-decoration: underline; }
  .foot .btn--alma, .foot .btn--alma:hover { color: #362954; text-decoration: none; }
  .foot .btn--ghost:hover { text-decoration: none; }
  .foot__art { position: absolute; right: -70px; top: -30px; width: 260px; height: auto; opacity: .12; z-index: -1; }
  .foot__title { font-size: clamp(34px, 7vw, 56px); font-weight: 400; line-height: 1; letter-spacing: -.03em; max-width: 12ch; }
  .foot__title b { font-weight: 700; }
  .foot__grid { display: grid; gap: 22px; margin-top: 28px; }
  .foot__col { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; font-size: 17px; line-height: 1.5; }
  .foot__k { font: 500 14px/1.3 var(--font-sans); color: rgb(255 255 255 / .7); }
  .social { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px; border-radius: 999px; background: rgb(255 255 255 / .14); font-weight: 600; transition: background .15s; }
  .foot .social:hover { background: rgb(255 255 255 / .26); text-decoration: none; }
  .foot__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .foot__bottom { display: flex; flex-direction: column; gap: 16px; margin-top: 32px; padding-top: 24px; border-top: 1px solid rgb(255 255 255 / .14); font-size: 15px; color: rgb(255 255 255 / .7); }
  .foot__bottom nav { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .foot__bottom span a { text-decoration: underline; }
  @media (min-width: 768px) {
    .foot { border-radius: var(--r-xl); padding: 64px 48px 32px; }
    .foot__art { width: 520px; right: -40px; }
    .foot__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; margin-top: 48px; }
    .foot__cta { margin-top: 40px; }
  }
  @media (min-width: 1100px) {
    .foot__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .foot__bottom { flex-direction: row; justify-content: space-between; gap: 24px; margin-top: 64px; font-size: 16px; }
  }
</style>
