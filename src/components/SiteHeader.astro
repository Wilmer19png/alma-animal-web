---
// Barra superior de las páginas internas (el Inicio lleva la suya dentro de la portada).
import Lockup from './Lockup.astro';
import MobileMenu from './MobileMenu.astro';
import { NAV, PHONES } from '../data/site';
const path = Astro.url.pathname.replace(/\.html$/, '');
const isOn = (href: string) => href !== '/' && path.startsWith(href);
---
<div class="site-bar">
  <div class="wrap site-bar__in">
    <Lockup />
    <nav class="navpill" aria-label="Principal">
      {NAV.map((n) => <a href={n.href} class={isOn(n.href) ? 'is-on' : undefined} aria-current={isOn(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="site-bar__tools">
      <a class="icon-btn hide-sm" href={`tel:+${PHONES.vet.e164}`} aria-label={`Llamar al ${PHONES.vet.display}`}><span class="ms" aria-hidden="true">call</span></a>
      <a class="icon-btn" href="/petshop" aria-label="Carrito"><span class="ms" aria-hidden="true">shopping_bag</span></a>
      <a class="btn hide-sm" href="/portal">Ingresar</a>
      <MobileMenu />
    </div>
  </div>
</div>

<style>
  .site-bar { position: sticky; top: 0; z-index: 30; background: rgb(254 247 254 / .94); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .site-bar__in { display: flex; align-items: center; gap: 10px; padding-block: 12px; }
  .navpill { display: none; }
  .site-bar__tools { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .hide-sm { display: none; }
  @media (min-width: 1100px) {
    .site-bar { position: static; background: none; backdrop-filter: none; -webkit-backdrop-filter: none; }
    .site-bar__in { gap: 24px; padding-block: 24px; }
    .navpill { display: flex; gap: 2px; padding: 5px; border-radius: 999px; background: #fff; box-shadow: 0 0 0 1px var(--line); margin-left: 8px; }
    .navpill a { font: 600 15px/1 var(--font-sans); color: var(--ink-muted); text-decoration: none; padding: 11px 14px; border-radius: 999px; transition: background .15s; }
    .navpill a:hover { background: var(--surface-3); color: var(--ink); }
    .navpill a.is-on { background: var(--ink); color: #fff; }
    .site-bar__tools { gap: 12px; }
    .hide-sm { display: inline-flex; }
    .icon-btn.hide-sm { display: inline-grid; }
  }
</style>
