---
import { NAV } from '../data/site';
const path = Astro.url.pathname;
---
<details class="mnav">
  <summary aria-label="Abrir el menú">
    <span class="ms m-open" aria-hidden="true">menu</span>
    <span class="ms m-close" aria-hidden="true">close</span>
  </summary>
  <nav class="mnav__panel" aria-label="Menú">
    {NAV.map((n) => (
      <a href={n.href} class={n.href === path ? 'is-on' : undefined} aria-current={n.href === path ? 'page' : undefined}>
        {n.label}<span class="ms" aria-hidden="true">chevron_right</span>
      </a>
    ))}
    <a class="btn mnav__login" href="/portal"><span class="ms" aria-hidden="true">person</span>Ingresar a mi portal</a>
  </nav>
</details>

<style>
  .mnav { position: relative; }
  .mnav summary { list-style: none; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: #fff; cursor: pointer; }
  .mnav summary::-webkit-details-marker { display: none; }
  .m-close { display: none; }
  .mnav[open] .m-open { display: none; }
  .mnav[open] .m-close { display: inline-block; }
  .mnav__panel { position: absolute; right: 0; top: 54px; z-index: 50; width: min(300px, calc(100vw - 32px)); padding: 10px; border-radius: 24px; background: #fff; box-shadow: 0 0 0 1px var(--line-soft), 0 14px 32px rgb(54 41 84 / .2); display: flex; flex-direction: column; gap: 2px; }
  .mnav__panel a:not(.btn) { display: flex; align-items: center; justify-content: space-between; min-height: 48px; padding: 0 16px; border-radius: 14px; font: 600 17px/1 var(--font-sans); color: var(--ink); text-decoration: none; }
  .mnav__panel a:not(.btn):hover { background: var(--surface-2); }
  .mnav__panel a .ms { font-size: 18px; color: var(--primary); }
  .mnav__panel a.is-on { background: var(--surface-3); }
  .mnav__login { margin-top: 8px; }
  @media (min-width: 1100px) { .mnav { display: none; } }
</style>
